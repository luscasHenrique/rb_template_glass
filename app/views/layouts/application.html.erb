<!DOCTYPE html>
<html lang="pt-BR">
  <head>
    <title><%= content_for(:title) || "Dashboard - Template Glass" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <%= stylesheet_link_tag "tailwind", "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <!-- Adicionado p-4 e gap-6 no body para criar o respiro entre as bordas -->
  <body class="h-screen w-full bg-cover bg-center bg-no-repeat bg-fixed font-sans antialiased text-white flex p-4 gap-6 overflow-hidden" 
        style="background-image: url('<%= asset_path('wall_08.png') %>');">
    
    <!-- Renderiza a Sidebar apenas se houver usuário logado -->
    <%= render(SidebarComponent.new(user: current_user)) if current_user %>

    <!-- Adicionado gap-6 para separar o Header da área do Main -->
    <div class="flex flex-col flex-1 min-w-0 h-full gap-6">
      <!-- Renderiza o Header dinâmico -->
      <%= render(HeaderComponent.new(title: yield(:title))) if current_user %>
      
      <!-- Área Principal onde os Bento Cards serão renderizados -->
      <main class="flex-1 overflow-y-auto pb-2 scroll-smooth">
    
        <div class="w-full space-y-6">
          <%= yield %>
        </div>
      </main>
    </div>

    
    <!-- Componente Global de Notificações -->
    <%= render "shared/flash_messages" %>
  </body>
</html>