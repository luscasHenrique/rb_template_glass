<!DOCTYPE html>
<html lang="pt-BR">
  <head>
    <title><%= content_for(:title) || "Dashboard - Template Glass" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <%= stylesheet_link_tag "tailwind", "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>

    <!-- ==========================================
         GATEKEEPER LGPD & TRACKING INTEGRATIONS
         ========================================== -->
    <% if cookies[:cookie_consent] == "true" %>
      
      <%# Busca o provedor GTM de forma segura e modular no banco %>
      <% gtm = TrackingIntegration.find_by(provider_name: 'GTM', is_active: true) %>
      
      <% if gtm.present? && gtm.account_id.present? %>
        <!-- Google Tag Manager Injetado Dinamicamente -->
        <script>
          (function(w,d,s,l,i){w[l]=w[l]||[];w[l].push({'gtm.start':
          new Date().getTime(),event:'gtm.js'});var f=d.getElementsByTagName(s)[0],
          j=d.createElement(s),dl=l!='dataLayer'?'&l='+l:'';j.async=true;j.src=
          'https://www.googletagmanager.com/gtm.js?id='+i+dl;f.parentNode.insertBefore(j,f);
          })(window,document,'script','dataLayer','<%= gtm.account_id %>');
        </script>
      <% end %>
      
    <% end %>
  </head>


  <body class="h-screen w-full bg-cover bg-center bg-no-repeat bg-fixed font-sans antialiased text-white flex gap-x-6 p-4 overflow-hidden" 
        style="background-image: url('<%= asset_path('wall_08.png') %>');">

    <!-- Renderiza a Sidebar apenas se houver usuário logado -->
    <%= render(SidebarComponent.new(user: current_user)) if current_user %>
    
    <div class="flex flex-col flex-1 min-w-0 h-full space-y-6">
      <!-- Renderiza o Header dinâmico -->
      <%= render(HeaderComponent.new(title: yield(:title))) if current_user %>
      
      <!-- Área Principal onde os Bento Cards serão renderizados -->
      <main class="flex-1 overflow-y-auto scroll-smooth space-y-6" >
          <%= yield %>
      </main>
    </div>

    
    <!-- Fora do fluxo do Flexbox: Não afeta as margens laterais -->
    <div class="fixed inset-0 pointer-events-none z-50">
      <div class="pointer-events-auto">
        <%= render "shared/flash_messages" %>
        <%= render "shared/cookie_banner" %>
      </div>
    </div>
  </body>
</html>