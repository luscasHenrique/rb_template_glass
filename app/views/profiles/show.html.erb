<% content_for :title, "Detalhes do Perfil" %>

<div class="glass-card max-w-4xl mx-auto mt-8">
  <div class="flex flex-col sm:flex-row justify-between items-start sm:items-center mb-8 border-b border-white/10 pb-6 gap-4">
    <h1 class="text-3xl font-bold text-white tracking-tight flex items-center gap-3">
      <%= icon "identification", class: "text-blue-400 w-8 h-8" %>
      Ficha do Usuário
    </h1>
    <div class="flex gap-2">
      <%= render "shared/components/button", text: "Voltar", type: "link", path: profiles_path, variant: "secondary" %>
      <%= render "shared/components/icon_button", icon: "pencil-square", path: edit_profile_path(@profile), title: "Editar", variant: "warning" %>
    </div>
  </div>

  <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
    <!-- Coluna de Foto -->
    <div class="flex flex-col items-center justify-center glass-card-sm !p-8">
      <div class="w-32 h-32 rounded-full bg-black/40 border-4 border-white/10 flex items-center justify-center overflow-hidden mb-4 shadow-xl">
        <% if @profile.avatar_url.present? %>
          <img src="<%= @profile.avatar_url %>" class="w-full h-full object-cover">
        <% else %>
          <%= icon "user", class: "w-16 h-16 text-white/20" %>
        <% end %>
      </div>
      <h2 class="text-xl font-bold text-white text-center"><%= @profile.first_name %> <%= @profile.last_name %></h2>
      <span class="text-sm text-white/50 mt-1">ID Usuário: <%= @profile.user_id %></span>
    </div>

    <!-- Coluna de Dados -->
    <div class="md:col-span-2 grid grid-cols-1 sm:grid-cols-2 gap-4">
      <div class="glass-card-sm">
        <span class="glass-label-sm uppercase">Telefone</span>
        <span class="text-white font-medium text-lg block mt-1"><%= @profile.phone.presence || "Não informado" %></span>
      </div>
      
      <div class="glass-card-sm sm:col-span-2">
        <span class="glass-label-sm uppercase">Biografia</span>
        <p class="text-white/80 mt-2 whitespace-pre-wrap break-all"><%= @profile.bio.presence || "Nenhuma biografia fornecida." %></p>
      </div>
    </div>
  </div>
</div>