<% content_for :title, "Gestão de Perfis" %>

<div class="glass-card">
  
  <div class="flex flex-col sm:flex-row justify-between items-start sm:items-center mb-8 gap-4">
    <div>
      <h2 class="text-3xl font-bold text-white tracking-tight flex items-center gap-3">
        <%= icon "users", class: "text-blue-400 w-8 h-8" %>
        Perfis de Usuários
      </h2>
      <p class="text-white/60 text-sm mt-1">Gerencie os dados pessoais e informações de contato.</p>
    </div>
    
    <%= render "shared/components/button", 
               text: "Novo Perfil", type: "link", path: new_profile_path, variant: "primary", icon: "plus" %>
  </div>

  <div class="overflow-x-auto">
    <table class="min-w-full divide-y divide-white/10 text-left border-collapse">
      <thead>
        <tr>
          <th class="p-4 text-sm font-semibold text-white/80">Nome Completo</th>
          <th class="p-4 text-sm font-semibold text-white/80">Telefone</th>
          <th class="p-4 text-sm font-semibold text-white/80">Biografia</th>
          <th class="p-4 text-sm font-semibold text-white/80 text-right">Ações</th>
        </tr>
      </thead>
      <tbody class="divide-y divide-white/10">
        <% if @profiles.any? %>
          <% @profiles.each do |profile| %>
            <tr class="hover:bg-white/5 transition-colors">
              <td class="p-4 text-sm font-medium text-white flex items-center gap-3">
                <!-- Mini Avatar Placeholder -->
                <div class="w-8 h-8 rounded-full bg-white/10 flex items-center justify-center border border-white/20 shrink-0 overflow-hidden">
                  <% if profile.avatar_url.present? %>
                    <img src="<%= profile.avatar_url %>" class="w-full h-full object-cover">
                  <% else %>
                    <%= icon "user", class: "w-4 h-4 text-white/50" %>
                  <% end %>
                </div>
                <%= profile.first_name %> <%= profile.last_name %>
              </td>
              
              <td class="p-4 text-sm text-white/70"><%= profile.phone.presence || "—" %></td>
              
              <td class="p-4 text-sm text-white/50 max-w-xs truncate"><%= profile.bio.presence || "Sem biografia" %></td>
              
              <td class="p-4 text-right">
                <div class="flex items-center justify-end gap-2">
                  <%= render "shared/components/icon_button", icon: "eye", path: profile_path(profile), title: "Detalhes", variant: "info" %>
                  <%= render "shared/components/icon_button", icon: "pencil-square", path: edit_profile_path(profile), title: "Editar", variant: "warning" %>
                  <%= render "shared/components/icon_button", type: "button_to", method: :delete, icon: "trash", path: profile_path(profile), title: "Excluir", variant: "danger", data: { turbo_confirm: "Tem certeza que deseja excluir este perfil?" } %>
                </div>
              </td>
            </tr>
          <% end %>
        <% else %>
          <tr>
            <td colspan="4" class="p-8 text-center text-white/50 text-sm bg-black/20 rounded-xl border border-white/5">
              Nenhum perfil cadastrado.
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
</div>