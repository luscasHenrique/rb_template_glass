<%= form_with(model: profile, class: "space-y-6") do |form| %>
  
  <!-- Tratamento de Erros Padronizado -->
  <% if profile.errors.any? %>
    <div id="error_explanation" class="bg-rose-500/10 border border-rose-500/50 text-rose-200 px-4 py-3 rounded-xl mb-6 shadow-[0_0_15px_rgba(225,29,72,0.2)]">
      <h2 class="font-bold mb-2 text-rose-400 text-sm uppercase tracking-wider">
        <%= pluralize(profile.errors.count, "erro impediu", "erros impediram") %> o perfil de ser salvo:
      </h2>
      <ul class="list-disc ml-6 text-sm">
        <% profile.errors.each do |error| %>
          <li><%= error.full_message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
    <!-- Nome -->
    <%= render "shared/components/input", 
               form: form, field: :first_name, label: "Nome", placeholder: "Ex: João",
               variant: profile.errors[:first_name].any? ? "danger" : "default" %>

    <!-- Sobrenome -->
    <%= render "shared/components/input", 
               form: form, field: :last_name, label: "Sobrenome", placeholder: "Ex: Silva",
               variant: profile.errors[:last_name].any? ? "danger" : "default" %>

    <!-- Telefone -->
    <%= render "shared/components/input", 
               form: form, field: :phone, label: "Telefone", placeholder: "(00) 00000-0000",
               variant: profile.errors[:phone].any? ? "danger" : "default" %>

    <!-- Avatar URL -->
    <%= render "shared/components/input", 
               form: form, field: :avatar_url, label: "URL do Avatar", placeholder: "https://...",
               variant: profile.errors[:avatar_url].any? ? "danger" : "default" %>
  </div>

  <!-- Bio (Ocupando a largura total) -->
  <%= render "shared/components/textarea", 
             form: form, field: :bio, label: "Biografia", rows: 4, placeholder: "Conte um pouco sobre o usuário...",
             variant: profile.errors[:bio].any? ? "danger" : "default" %>

  <!-- Botões de Ação no Rodapé -->
  <div class="pt-6 mt-6 border-t border-white/10 flex items-center justify-between">
    <%= render "shared/components/button", 
               text: "Cancelar", type: "link", path: profiles_path, variant: "secondary" %>

    <%= render "shared/components/button", 
               text: "Salvar Perfil", type: "submit", variant: "success", icon: "check" %>
  </div>
<% end %>