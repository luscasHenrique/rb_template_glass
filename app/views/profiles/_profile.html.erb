<div id="<%= dom_id profile %>" class="grid grid-cols-1 md:grid-cols-3 gap-6">
  <!-- Coluna de Foto (Avatar) -->
  <div class="flex flex-col items-center justify-center glass-card-sm !p-8">
    <div class="w-32 h-32 rounded-full bg-black/40 border-4 border-white/10 flex items-center justify-center overflow-hidden mb-4 shadow-xl shrink-0">
      <% if profile.avatar_url.present? %>
        <img src="<%= profile.avatar_url %>" class="w-full h-full object-cover">
      <% else %>
        <%= icon "user", class: "w-16 h-16 text-white/20" %>
      <% end %>
    </div>
    <h2 class="text-xl font-bold text-white text-center"><%= profile.first_name %> <%= profile.last_name %></h2>
    <span class="text-sm text-white/50 mt-1">ID Usuário: <%= profile.user_id %></span>
  </div>

  <!-- Coluna de Dados de Contato e Bio -->
  <div class="md:col-span-2 grid grid-cols-1 sm:grid-cols-2 gap-4">
    <div class="glass-card-sm">
      <span class="glass-label-sm uppercase">Telefone</span>
      <span class="text-white font-medium text-lg block mt-1"><%= profile.phone.presence || "Não informado" %></span>
    </div>
    
    <!-- Biografia ocupando 100% da largura do grid interno com quebra de linha defensiva -->
    <div class="glass-card-sm sm:col-span-2 flex flex-col">
      <span class="glass-label-sm uppercase mb-2">Biografia</span>
      <div class="bg-black/20 border border-white/5 rounded-lg p-4 flex-1">
        <p class="text-white/80 whitespace-pre-wrap break-all text-sm leading-relaxed"><%= profile.bio.presence || "Nenhuma biografia fornecida pelo usuário." %></p>
      </div>
    </div>
  </div>
</div>