<% content_for :title, "Editar Perfil" %>

<div class="glass-card">
  <div class="flex flex-col sm:flex-row justify-between items-start sm:items-center gap-4 mb-8 border-b border-white/10 pb-6">
    <div>
      <h1 class="text-3xl font-bold text-white tracking-tight flex items-center gap-3">
        <%= icon "pencil-square", class: "text-amber-400 w-8 h-8" %>
        Editar Perfil
      </h1>
      <p class="text-white/60 text-sm mt-1">Atualize os dados de contato ou biografia de <%= @profile.first_name %>.</p>
    </div>
    
    <%= render "shared/components/button", text: "Visualizar Perfil", type: "link", path: profile_path(@profile), variant: "outline-info", icon: "eye" %>
  </div>

  <%= render "form", profile: @profile %>
</div>