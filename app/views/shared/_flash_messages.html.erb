<div id="flash-messages-container" class="fixed top-4 right-4 z-50 flex flex-col gap-3">
  <% flash.each do |key, message| %>
    <% 
      # MAPEAMENTO ESTRATÉGICO DE HTTP STATUS CODES (Padrão Enterprise)
      status_key = key.to_s.downcase

      type = case status_key
             # SUCESSO (Verdes) - 2xx
             when "notice", "success", "200", "201", "202", "204", "205" 
               "success"
             
             # INFORMAÇÃO / REDIRECIONAMENTO (Azuis) - 3xx
             when "info", "301", "302", "303", "304", "307" 
               "info"
             
             # AVISOS E REGRAS DE NEGÓCIO (Amarelos)
             # Separamos o 422 (Entidade não processável) e 429 (Muitas requisições) 
             # pois geralmente são avisos para o usuário corrigir um dado ou aguardar.
             when "warning", "422", "429" 
               "warning"
             
             # ERROS DO CLIENTE E DO SERVIDOR (Vermelhos / Roxos) - 4xx e 5xx
             when "alert", "error", "danger", 
                  "400", "401", "403", "404", "405", "409", "410", "451", # Série 400
                  "500", "502", "503", "504", "511"                       # Série 500
               "danger"
             
             # DEFAULT FALLBACK
             else 
               "info"
             end
    %>

    <!-- O resto do código continua exatamente igual (as divs, ícones e o botão de fechar) -->
    <div data-controller="toast" class="glass-toast-<%= type %>" role="alert">
      
      <!-- Lógica de Ícones -->
      <% if type == "success" %>
        <svg class="h-6 w-6 text-emerald-400 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" /></svg>
      <% elsif type == "danger" %>
        <svg class="h-6 w-6 text-rose-400 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4m0 4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" /></svg>
      <% elsif type == "warning" %>
        <svg class="h-6 w-6 text-amber-400 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z" /></svg>
      <% else %>
        <svg class="h-6 w-6 text-cyan-400 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" /></svg>
      <% end %>

      <!-- Mensagem Renderizada -->
      <div class="ml-3 mr-6 text-sm font-medium text-white/90">
        <%= message %>
      </div>

      <!-- Botão Fechar -->
      <button type="button" data-action="click->toast#close" class="absolute top-4 right-3 text-white/40 hover:text-white rounded-lg focus:outline-none transition-colors cursor-pointer">
        <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" /></svg>
      </button>

    </div>
  <% end %>
</div>