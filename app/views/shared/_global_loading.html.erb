<div data-controller="loading" 
     data-loading-target="overlay" 
     class="glass-overlay hidden">
  
  <div class="flex flex-col items-center justify-center gap-6">
    
    <!-- Spinner Multicolorido de Alta Performance (Hardware Accelerated) -->
    <svg class="h-24 w-24 overflow-visible" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
      
      <!-- Topo (Tons de Azul e Índigo) -->
      <circle class="glass-dot" cx="12" cy="3" r="1.8" style="animation-delay: -1.1s; color: #3b82f6;" fill="currentColor"/>
      <circle class="glass-dot" cx="16.5" cy="4.2" r="1.8" style="animation-delay: -1.0s; color: #6366f1;" fill="currentColor"/>
      
      <!-- Direita (Tons de Roxo e Fúcsia) -->
      <circle class="glass-dot" cx="19.8" cy="7.5" r="1.8" style="animation-delay: -0.9s; color: #8b5cf6;" fill="currentColor"/>
      <circle class="glass-dot" cx="21" cy="12" r="1.8" style="animation-delay: -0.8s; color: #a855f7;" fill="currentColor"/>
      <circle class="glass-dot" cx="19.8" cy="16.5" r="1.8" style="animation-delay: -0.7s; color: #d946ef;" fill="currentColor"/>
      
      <!-- Base (Tons de Rosa e Vermelho) -->
      <circle class="glass-dot" cx="16.5" cy="19.8" r="1.8" style="animation-delay: -0.6s; color: #ec4899;" fill="currentColor"/>
      <circle class="glass-dot" cx="12" cy="21" r="1.8" style="animation-delay: -0.5s; color: #f43f5e;" fill="currentColor"/>
      <circle class="glass-dot" cx="7.5" cy="19.8" r="1.8" style="animation-delay: -0.4s; color: #ec4899;" fill="currentColor"/>
      
      <!-- Esquerda (Retornando para Roxo e Azul) -->
      <circle class="glass-dot" cx="4.2" cy="16.5" r="1.8" style="animation-delay: -0.3s; color: #d946ef;" fill="currentColor"/>
      <circle class="glass-dot" cx="3" cy="12" r="1.8" style="animation-delay: -0.2s; color: #a855f7;" fill="currentColor"/>
      <circle class="glass-dot" cx="4.2" cy="7.5" r="1.8" style="animation-delay: -0.1s; color: #8b5cf6;" fill="currentColor"/>
      <circle class="glass-dot" cx="7.5" cy="4.2" r="1.8" style="animation-delay: 0s; color: #6366f1;" fill="currentColor"/>
      
    </svg>
    
    <p class="glass-loader-text">Aguarde...</p>
    
  </div>

</div>