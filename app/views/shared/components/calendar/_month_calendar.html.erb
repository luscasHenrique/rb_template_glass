<div class="simple-calendar glass-card !p-0 overflow-hidden">

 

  <!-- CABEÇALHO DO CALENDÁRIO -->

  <div class="flex items-center justify-between bg-black/20 p-4 border-b border-white/10">

    <%= render "shared/components/icon_button",

               type: "link",

               icon: "chevron-left",

               path: calendar.url_for_previous_view,

               variant: "secondary",

               custom_class: "w-8 h-8" %>

   

    <time datetime="<%= start_date.strftime('%Y-%m') %>" class="text-lg font-bold text-white capitalize m-0">

      <%= t('date.month_names')[start_date.month] %> <%= start_date.year %>

    </time>



    <%= render "shared/components/icon_button",

               type: "link",

               icon: "chevron-right",

               path: calendar.url_for_next_view,

               variant: "secondary",

               custom_class: "w-8 h-8" %>

  </div>



  <!-- GRID DO MÊS -->

  <div class="overflow-x-auto">

    <table class="w-full text-left border-collapse">

      <thead class="bg-black/10">

        <tr>

          <% date_range.slice(0, 7).each do |day| %>

            <th class="p-3 text-xs font-semibold text-white/50 uppercase text-center border-b border-white/10 tracking-wider">

              <%= t('date.abbr_day_names')[day.wday] %>

            </th>

          <% end %>

        </tr>

      </thead>



      <tbody class="divide-y divide-white/10">

        <% date_range.each_slice(7) do |week| %>

          <tr class="divide-x divide-white/10">

            <% week.each do |day| %>

             

              <%

                day_classes = calendar.td_classes_for(day)

                is_today = day_classes.include?("today")

                bg_class = is_today ? "bg-white/10 shadow-[inset_0_0_15px_rgba(255,255,255,0.05)]" : "hover:bg-white/5"

              %>

             

              <%= content_tag :td, class: "h-28 align-top p-2 transition-colors w-[14.28%] #{bg_class}" do %>

               

                <!-- NÚMERO DO DIA (AGORA CLICÁVEL VIA TURBO) -->

                <div class="flex justify-end mb-1">

                  <%= link_to day.day, new_schedule_item_path(start_date: day, manager_id: params[:manager_id]),

    data: { turbo_frame: "modal_container" },

    title: "Adicionar agendamento neste dia",

    class: "w-7 h-7 flex items-center justify-center rounded-full text-xs font-mono transition-transform hover:scale-110 cursor-pointer #{is_today ? 'bg-violet-600 text-white font-bold shadow-[0_0_10px_rgba(124,58,237,0.5)]' : 'text-white/70 hover:bg-white/20'}" %>

                </div>

               

                <div class="space-y-1 overflow-y-auto max-h-16 custom-scrollbar pr-1">

                  <% instance_exec(day, calendar.sorted_events_for(day), &passed_block) %>

                </div>

              <% end %>

             

            <% end %>

          </tr>

        <% end %>

      </tbody>

    </table>

  </div>

</div>