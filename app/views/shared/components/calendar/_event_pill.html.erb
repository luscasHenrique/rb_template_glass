<%
  categoria = evento.schedule_category
  cor_base  = categoria ? categoria.color : "violet"
  icone_cat = categoria ? categoria.icon : "calendar"
%>

<!-- Pílula Clicável -->
<button onclick="document.getElementById('modal_evento_<%= evento.id %>').showModal()" 
        class="w-full flex items-center gap-1 text-left glass-text-xs <%= glass_theme_classes(cor_base, :pill) %> border rounded px-2 py-1 truncate mt-1 cursor-pointer transition-colors shadow-sm">
  <%= icon icone_cat, class: "w-3 h-3 shrink-0 opacity-70" %>
  <span class="font-bold shrink-0"><%= evento.start_time.strftime("%H:%M") %></span> 
  <span class="truncate"><%= evento.title %></span>
</button>

<!-- O Modal Exclusivo de Cada Evento -->
<%= render "shared/components/modal", id: "modal_evento_#{evento.id}", title: "Detalhes do Agendamento", icon: icone_cat do %>
  <div class="space-y-5">
    
    <!-- Cabeçalho do Evento -->
    <div>
      <h4 class="text-2xl font-bold text-white"><%= evento.title %></h4>
      <div class="flex flex-wrap gap-2 mt-2">
        <span class="inline-block px-3 py-1 bg-white/10 rounded-full text-sm text-white/80 border border-white/10">
          <%= icon "clock", class: "w-4 h-4 inline mr-1 -mt-0.5" %>
          <%= evento.start_time.strftime("%d/%m/%Y às %H:%M") %>
        </span>
        <% if categoria %>
          <span class="inline-block px-3 py-1 bg-white/5 rounded-full text-sm text-white/60 border border-white/10">
            <%= categoria.name %>
          </span>
        <% end %>
      </div>
    </div>

    <!-- LINK DA REUNIÃO (ZOOM / MEET) -->
    <% if evento.meeting_url.present? %>
      <div class="p-3.5 bg-violet-500/10 border border-violet-500/30 rounded-xl flex flex-col sm:flex-row items-start sm:items-center justify-between gap-3 shadow-inner">
        <div class="flex items-center gap-2.5 truncate w-full sm:w-auto">
          <%= icon "video-camera", class: "w-5 h-5 text-violet-400 shrink-0" %>
          <span class="text-xs text-white/70 truncate"><%= evento.meeting_url %></span>
        </div>
        <%= link_to evento.meeting_url, 
                    target: "_blank", 
                    rel: "noopener noreferrer", 
                    class: "glass-btn glass-btn-xsm glass-btn-primary w-full sm:w-auto shrink-0" do %>
          <%= icon "arrow-top-right-on-square", class: "w-4 h-4" %>
          <span>Entrar na Reunião</span>
        <% end %>
      </div>
    <% end %>

    <!-- Descrição e Pauta -->
    <div class="bg-black/20 p-4 rounded-xl border border-white/5">
      <span class="glass-label-sm uppercase mb-1">Descrição e Pauta</span>
      <p class="text-white/80"><%= evento.description.presence || "Nenhuma descrição fornecida para este compromisso." %></p>
    </div>

    <!-- MÓDULO DE RSVP E LISTA DE CONVIDADOS -->
    <% if evento.schedule_guests.any? %>
      <div class="bg-black/20 p-4 rounded-xl border border-white/5 space-y-3">
        <span class="glass-label-sm uppercase block mb-2">Convidados e Presença</span>
        
        <!-- Ação do Usuário Atual (Se for Convidado) -->
        <% meu_convite = evento.schedule_guests.find_by(user_id: current_user.id) %>
        <% if meu_convite.present? %>
          <div class="bg-violet-900/30 p-3 rounded-lg border border-violet-500/30 flex flex-col sm:flex-row items-center justify-between gap-3 mb-3">
            <div>
              <span class="text-xs text-white/60 block">Sua resposta:</span>
              <% if meu_convite.confirmed? %>
                <span class="text-emerald-400 font-bold text-sm flex items-center gap-1"><%= icon "check-circle", class: "w-4 h-4" %> Confirmada</span>
              <% elsif meu_convite.declined? %>
                <span class="text-rose-400 font-bold text-sm flex items-center gap-1"><%= icon "x-circle", class: "w-4 h-4" %> Recusada</span>
              <% else %>
                <span class="text-amber-400 font-bold text-sm flex items-center gap-1"><%= icon "clock", class: "w-4 h-4" %> Pendente</span>
              <% end %>
            </div>

            <% if evento.start_time > Time.current %>
              <div class="flex gap-2">
                <%= render "shared/components/icon_button", 
                           type: "button_to", 
                           method: :patch, 
                           path: schedule_item_schedule_guest_path(evento, meu_convite, schedule_guest: { status: "confirmed" }), 
                           icon: "check", 
                           variant: "success", 
                           title: "Confirmar Presença" %>
                           
                <%= render "shared/components/icon_button", 
                           type: "button_to", 
                           method: :patch, 
                           path: schedule_item_schedule_guest_path(evento, meu_convite, schedule_guest: { status: "declined" }), 
                           icon: "x-mark", 
                           variant: "danger", 
                           title: "Recusar Presença" %>
              </div>
            <% end %>
          </div>
        <% end %>

        <!-- Lista de Status de Todos os Participantes -->
        <div class="space-y-2 max-h-36 overflow-y-auto custom-scrollbar pr-1">
          <% evento.schedule_guests.includes(user: :profile).each do |guest| %>
            <div class="flex items-center justify-between text-xs py-1.5 border-b border-white/5 last:border-0">
              <span class="text-white/80">
                <%= guest.user.profile ? "#{guest.user.profile.first_name} #{guest.user.profile.last_name}" : guest.user.email %>
              </span>
              <% if guest.confirmed? %>
                <span class="text-emerald-400 text-[10px] font-bold uppercase px-2 py-0.5 rounded bg-emerald-500/10 border border-emerald-500/20">Confirmado</span>
              <% elsif guest.declined? %>
                <span class="text-rose-400 text-[10px] font-bold uppercase px-2 py-0.5 rounded bg-rose-500/10 border border-rose-500/20">Recusado</span>
              <% else %>
                <span class="text-amber-400 text-[10px] font-bold uppercase px-2 py-0.5 rounded bg-amber-500/10 border border-amber-500/20">Pendente</span>
              <% end %>
            </div>
          <% end %>
        </div>
      </div>
    <% end %>
    
    <!-- Rodapé com Ações Inteligentes -->
    <div class="pt-4 border-t border-white/10 flex justify-between items-center gap-3">
       <div>
         <% if policy(evento).destroy? %>
           <%= render "shared/components/icon_button", type: "button_to", method: :delete, path: schedule_item_path(evento), icon: "trash", variant: "danger", data: { turbo_confirm: "Cancelar este agendamento definitivamente?" } %>
         <% end %>
       </div>

       <div class="flex gap-3">
         <button data-action="click->modal#close" class="glass-btn glass-btn-md glass-btn-secondary">Fechar</button>
         <% if policy(evento).edit? %>
           <%= render "shared/components/button", text: "Editar / Gerenciar", type: "link", path: edit_schedule_item_path(evento), variant: "primary", icon: "pencil", data: { turbo_frame: "modal_container" } %>
         <% end %>
       </div>
    </div>
  </div>
<% end %>