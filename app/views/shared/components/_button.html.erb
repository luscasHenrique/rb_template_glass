<%
  # ==========================================
  # 📚 COMPONENTE DE BOTÃO UNIFICADO (DESIGN SYSTEM)
  # ==========================================
  
  cmp_text = local_assigns.fetch(:text, nil)
  
  # Opcionais com Defaults Seguros
  cmp_variant       = local_assigns.fetch(:variant, "primary")
  cmp_type          = local_assigns.fetch(:type, "button") # link, button, button_to, submit
  cmp_method        = local_assigns.fetch(:method, :get)   # Para quando type == 'button_to'
  cmp_path          = local_assigns.fetch(:path, "#")
  
  cmp_icon          = local_assigns.fetch(:icon, nil)
  cmp_icon_position = local_assigns.fetch(:icon_position, "left")
  cmp_loading_text  = local_assigns.fetch(:loading_text, "Aguarde...")
  cmp_disable_loading = local_assigns.fetch(:disable_loading, false)
  
  cmp_custom_class  = local_assigns.fetch(:custom_class, "")
  cmp_data          = local_assigns.fetch(:data, {})
  cmp_onclick       = local_assigns.fetch(:onclick, nil)

  # ARQUITETURA SEGURA (Stimulus)
  existing_controllers = cmp_data[:controller].to_s
  existing_actions     = cmp_data[:action].to_s

  if cmp_disable_loading
    merged_data = cmp_data
  else
    merged_data = cmp_data.merge({
      controller: "#{existing_controllers} button-loading".squish,
      action: "#{existing_actions} click->button-loading#load".squish
    })
  end

  # ==========================================
  # LÓGICA DE TAMANHO & VARIANTES
  # ==========================================
  has_size = cmp_custom_class.match?(/(glass-btn-(xsm|sm|md|lg)|\bp-|\bpx-|\bpy-)/)
  default_size = has_size ? "" : "glass-btn-md"
  base_classes = "glass-btn relative outline-none focus:ring-2 focus:ring-offset-2 focus:ring-offset-black/50"

  variant_classes = case cmp_variant
    when "warning", "outline-warning" then "glass-btn-outline-warning"
    when "blue", "outline-blue", "primary" then "glass-btn-outline-blue"
    when "danger", "outline-danger" then "glass-btn-outline-danger"
    when "success", "outline-success" then "glass-btn-outline-success"
    when "white", "outline-white" then "glass-btn-outline-white"
    when "black", "outline-black" then "glass-btn-outline-black"
    when "none" then ""
  else
    if cmp_variant.start_with?("outline-")
      "glass-btn-#{cmp_variant} focus:ring-white/50"
    else
      "glass-btn-secondary focus:ring-white/50"
    end
  end

  final_classes = "#{base_classes} #{default_size} #{variant_classes} #{cmp_custom_class}".squish
  icon_html = cmp_icon.present? ? icon(cmp_icon, class: "w-5 h-5 shrink-0") : ""
%>

<%# ==========================================
    ESTRUTURA DE RENDERIZAÇÃO
    ========================================== %>
<% button_content = capture do %>
  <!-- ESTADO NORMAL -->
  <div class="flex items-center justify-center gap-2" data-button-loading-target="normal">
    <%= icon_html.html_safe if cmp_icon_position == "left" %>
    <% if cmp_text.present? %>
      <span><%= cmp_text %></span>
    <% end %>
    <%= icon_html.html_safe if cmp_icon_position == "right" %>
  </div>

  <!-- ESTADO DE LOADING -->
  <div class="hidden items-center justify-center gap-2" data-button-loading-target="loading">
    <%= icon "arrow-path", class: "w-5 h-5 animate-spin shrink-0" %> 
    <span><%= cmp_loading_text %></span>
  </div>
<% end %>

<% if cmp_type == "link" %>
  <%= link_to cmp_path, class: final_classes, data: merged_data do %>
    <%= button_content %>
  <% end %>

<% elsif cmp_type == "button_to" %>
  <%# Garante o micro-form seguro para ações destrutivas e mantém o CSS intacto %>
  <%= button_to cmp_path, method: cmp_method, class: final_classes, form_class: "inline-block m-0 p-0 w-full sm:w-auto", data: merged_data, onclick: cmp_onclick do %>
    <%= button_content %>
  <% end %>

<% else %>
  <%= button_tag type: cmp_type, class: final_classes, data: merged_data, onclick: cmp_onclick do %>
    <%= button_content %>
  <% end %>
<% end %>