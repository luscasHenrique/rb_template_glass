<%
  # ==========================================
  # 📚 COMPONENTE DE INPUT (DESIGN SYSTEM)
  # ==========================================
  # Delega 100% da responsabilidade visual para o application.css
  
  cmp_form  = local_assigns.fetch(:form)
  cmp_field = local_assigns.fetch(:field)

  # Opcionais com Defaults Seguros
  cmp_type         = local_assigns.fetch(:type, "text")
  cmp_variant      = local_assigns.fetch(:variant, "default")
  cmp_custom_class = local_assigns.fetch(:custom_class, "")
  cmp_placeholder  = local_assigns.fetch(:placeholder, "")
  cmp_label        = local_assigns.fetch(:label, nil)
  cmp_input_data   = local_assigns.fetch(:input_data, {})

  # ==========================================
  # 1. LÓGICA DE TAMANHO (Smart Sizing)
  # ==========================================
  has_size = cmp_custom_class.match?(/(glass-input-(sm|md|lg)|\bp-|\bpx-|\bpy-)/)
  default_size = has_size ? "" : "glass-input-md"

  # ==========================================
  # 2. DICIONÁRIO DE VARIANTES (Delegação para o CSS)
  # ==========================================
  base_classes = "glass-input"

  variant_classes = case cmp_variant
  when "danger", "error"
    "glass-input-error"
  when "success"
    "glass-input-success"
  when "warning"
    "glass-input-warning"
  when "info"
    "glass-input-info"
  else
    "glass-input-default"
  end

  final_classes = "#{base_classes} #{default_size} #{variant_classes} #{cmp_custom_class}".squish
  
  label_color = (cmp_variant == "danger" || cmp_variant == "error") ? "text-rose-400" : "glass-label"
%>

<div class="space-y-1 w-full">
  <% if cmp_label.present? %>
    <%= cmp_form.label cmp_field, cmp_label, class: label_color %>
  <% end %>
  
  <%# Evitamos o public_send para não quebrar com métodos mágicos do Rails. Somos explícitos. %>
  <% if cmp_type == "date" %>
    <%= cmp_form.date_field cmp_field, class: final_classes, placeholder: cmp_placeholder, data: cmp_input_data %>
  <% elsif cmp_type == "email" %>
    <%= cmp_form.email_field cmp_field, class: final_classes, placeholder: cmp_placeholder, data: cmp_input_data %>
  <% elsif cmp_type == "number" %>
    <%= cmp_form.number_field cmp_field, class: final_classes, placeholder: cmp_placeholder, data: cmp_input_data %>
  <% elsif cmp_type == "password" %>
    <%= cmp_form.password_field cmp_field, class: final_classes, placeholder: cmp_placeholder, data: cmp_input_data %>
  <% elsif cmp_type == "datetime-local" %>
    <%= cmp_form.datetime_field cmp_field, class: final_classes, placeholder: cmp_placeholder, data: cmp_input_data %>
  <% else %>
    <%= cmp_form.text_field cmp_field, class: final_classes, placeholder: cmp_placeholder, data: cmp_input_data %>
  <% end %>
</div>