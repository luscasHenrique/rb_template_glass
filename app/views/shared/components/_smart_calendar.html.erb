<%
  # CONTRATO DA API DO COMPONENTE
  cmp_eventos = local_assigns.fetch(:eventos, [])
  visao_atual = params.fetch(:view, "month")
%>

<div class="glass-card w-full">
  <!-- CABEÇALHO E TOGGLE DE VISÃO -->
  <div class="flex flex-col sm:flex-row justify-between items-start sm:items-center mb-6 border-b border-white/10 pb-4 gap-4">
    <h2 class="glass-section-title mb-0">
      <%= icon "calendar", class: "glass-icon-primary" %>
      Agenda Corporativa
    </h2>
    
    <div>
      <% if visao_atual == "month" %>
        <%= render "shared/components/button", text: "Ver Visão Semanal", type: "link", path: url_for(request.query_parameters.merge(view: "week")), variant: "outline-blue", icon: "view-columns" %>
      <% else %>
        <%= render "shared/components/button", text: "Ver Visão Mensal", type: "link", path: url_for(request.query_parameters.merge(view: "month")), variant: "outline-blue", icon: "calendar-days" %>
      <% end %>
    </div>
  </div>

  <!-- RENDERIZAÇÃO DA GEM DE CALENDÁRIO -->
  <% if visao_atual == "month" %>
    <%= month_calendar(events: cmp_eventos, partial: "shared/components/calendar/month_calendar") do |date, eventos_do_dia| %>
      <%= render partial: "shared/components/calendar/event_pill", collection: eventos_do_dia, as: :evento %>
    <% end %>
  <% else %>
    <%= week_calendar(events: cmp_eventos, partial: "shared/components/calendar/week_calendar") do |date, eventos_do_dia| %>
      <%= render partial: "shared/components/calendar/event_pill", collection: eventos_do_dia, as: :evento %>
    <% end %>
  <% end %>
</div>