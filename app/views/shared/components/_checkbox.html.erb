<%
  # ==========================================
  # 📚 COMO USAR ESTE COMPONENTE (Documentação p/ Equipe):
  # ==========================================
  # Este componente renderiza um Checkbox único (Boolean), ideal para Termos de Uso, 
  # status de 'Ativo/Inativo', ou opções de 'Opt-in' (ex: LGPD).
  #
  # <%= render "shared/components/checkbox", 
  #            form: form, 
  #            field: :terms_accepted, 
  #            label: "Aceito os Termos de Uso",
  #            description: "Obrigatório para concluir o cadastro.",
  #            variant: @user.errors[:terms_accepted].any? ? "danger" : "default",
  #            custom_class: "p-4 mb-6 w-full md:w-1/2",
  #            input_data: { action: "change->form#toggleSubmit" }
  # % >

  # ==========================================
  # 1. CONTRATO DE API DO COMPONENTE
  # ==========================================
  # Obrigatórios (Impede falhas silenciosas na View)
  cmp_form  = local_assigns.fetch(:form)
  cmp_field = local_assigns.fetch(:field)

  # Opcionais com Defaults Seguros
  cmp_variant      = local_assigns.fetch(:variant, "default")
  cmp_custom_class = local_assigns.fetch(:custom_class, "p-4")
  cmp_label        = local_assigns.fetch(:label, nil)
  cmp_description  = local_assigns.fetch(:description, nil)
  cmp_input_data   = local_assigns.fetch(:input_data, {})

  # ==========================================
  # 2. DICIONÁRIO DE VARIANTES (OS PRÉ-ESTILOS)
  # ==========================================
  # Base para o container (a caixa inteira)
  base_classes = "flex items-center gap-3 rounded-xl border transition-colors duration-200"

  variant_classes = case cmp_variant
  when "danger" # Vermelho para alertas de erro
    "bg-rose-500/10 border-rose-500/50 hover:bg-rose-500/20"
  when "success" # Verde para ações concluídas
    "bg-emerald-500/10 border-emerald-500/50 hover:bg-emerald-500/20"
  when "outline" # Estilo mais limpo, sem fundo preenchido
    "bg-transparent border-white/30 hover:border-violet-500"
    when "minimal" 
    "bg-transparent border-transparent p-0"
  else
    "bg-white/5 border-white/10 hover:bg-white/10"
  end

  # ==========================================
  # 3. MERGE DAS CLASSES
  # ==========================================
  final_classes = "#{base_classes} #{variant_classes} #{cmp_custom_class}".strip

  # Ajuste dinâmico da cor do texto baseado na variante para manter acessibilidade (Contraste)
  text_color = cmp_variant == "danger" ? "text-rose-100" : "text-white"
  desc_color = cmp_variant == "danger" ? "text-rose-200/70" : "text-white/50"
%>

<div class="<%= final_classes %>">
  <%= cmp_form.check_box cmp_field, class: "glass-checkbox", data: cmp_input_data %>
  
  <div>
    <% if cmp_label.present? %>
      <%= cmp_form.label cmp_field, cmp_label, class: "text-sm font-medium #{text_color} cursor-pointer select-none m-0 block" %>
    <% end %>
    
    <% if cmp_description.present? %>
      <span class="text-xs #{desc_color} mt-1 block"><%= cmp_description %></span>
    <% end %>
  </div>
</div>