<%
  # ==========================================
  # 📚 COMO USAR ESTE COMPONENTE (Documentação p/ Equipe):
  # ==========================================
  # Componente para seleção múltipla. Ideal para relações has_many (associações N:N) 
  # ou colunas do tipo Array no PostgreSQL. Substitui o uso de bibliotecas pesadas como Select2.
  #
  # <%= render "shared/components/multi_select", 
  #            form: form, 
  #            field: :tags, 
  #            label: "Departamentos de Atuação", 
  #            options: [["TI", "ti"], ["RH", "rh"], ["Financeiro", "fin"], ["Diretoria", "dir"]],
  #            placeholder: "Selecione os departamentos...",
  #            variant: @user.errors[:tags].any? ? "danger" : "default",
  #            custom_class: "w-full md:w-1/2"
  # % >

  # ==========================================
  # 1. CONTRATO DE API DO COMPONENTE
  # ==========================================
  # Obrigatórios (Impede Crash de tela e garante integridade do array)
  cmp_form    = local_assigns.fetch(:form)
  cmp_field   = local_assigns.fetch(:field)
  cmp_options = local_assigns.fetch(:options)

  # Opcionais com Defaults Seguros
  cmp_variant      = local_assigns.fetch(:variant, "default")
  cmp_custom_class = local_assigns.fetch(:custom_class, "w-full")
  cmp_label        = local_assigns.fetch(:label, nil)
  cmp_placeholder  = local_assigns.fetch(:placeholder, "Selecione várias opções...")
  cmp_input_data   = local_assigns.fetch(:input_data, {})

  # ==========================================
  # 2. DICIONÁRIO DE VARIANTES (Para o Botão Gatilho)
  # ==========================================
  base_button_classes = "glass-input glass-input-md transition-all duration-200 outline-none rounded-xl flex justify-between items-center cursor-pointer text-left"

  variant_button_classes = case cmp_variant
  when "danger"
    "bg-rose-500/10 border-rose-500/50 text-rose-100 placeholder-rose-200/50"
  when "outline"
    "bg-transparent border-white/30 text-white"
  else
    "bg-black/40 border-white/10 hover:bg-white/10 text-white"
  end

  final_button_classes = "#{base_button_classes} #{variant_button_classes} #{cmp_custom_class}".strip

  # Feedback visual dinâmico em caso de erro
  label_color = cmp_variant == "danger" ? "text-rose-400" : "glass-label"
  icon_color  = cmp_variant == "danger" ? "text-rose-400" : "text-white/50"
%>

<div class="space-y-1 relative" 
     data-controller="multi-select"
     data-placeholder="<%= cmp_placeholder %>"
     data-multi-select-active-class="bg-violet-500/30 text-white"
     data-multi-select-inactive-class="text-white/70">

  <% if cmp_label.present? %>
    <%= cmp_form.label cmp_field, cmp_label, class: label_color %>
  <% end %>

  <!-- SELECT OCULTO (Apenas para o Rails conversar com o Banco de Dados de forma nativa) -->
  <div class="hidden">
    <%= cmp_form.select cmp_field, options_for_select(cmp_options, cmp_form.object.send(cmp_field)), {}, multiple: true, data: { multi_select_target: "select" }.merge(cmp_input_data) %>
  </div>

  <!-- A INTERFACE QUE O USUÁRIO VÊ (Glassmorphism) -->
  <div class="relative">
    <!-- Botão Principal -->
    <button type="button" 
            data-action="click->multi-select#toggle" 
            class="<%= final_button_classes %>">
      
      <span data-multi-select-target="buttonText" class="truncate pr-4"><%= cmp_placeholder %></span>
      
      <%= icon "chevron-down", class: "w-4 h-4 shrink-0 #{icon_color}" %>
    </button>

    <!-- Menu Suspenso -->
    <div data-multi-select-target="menu" 
         class="absolute z-50 w-full mt-2 rounded-xl bg-black/90 backdrop-blur-2xl border border-white/10 shadow-2xl hidden max-h-60 overflow-y-auto">
      
      <% cmp_options.each do |opt_label, opt_value| %>
        <div data-action="click->multi-select#select" 
             data-multi-select-target="option"
             data-value="<%= opt_value %>"
             class="px-4 py-3 cursor-pointer transition-colors hover:bg-white/10 text-sm flex items-center justify-between text-white/70">
          
          <%= opt_label %>
          
          <!-- Um indicador visual (check) que só aparece quando selecionado via JS -->
          <span class="opacity-0 transition-opacity" style="display: none;">✓</span>
        </div>
      <% end %>
      
    </div>
  </div>
</div>