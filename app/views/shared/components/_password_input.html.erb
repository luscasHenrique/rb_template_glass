<%
  # ==========================================
  # 1. DEFINIÇÃO DE VALORES DEFAULT
  # ==========================================
  variant ||= "default"
  custom_class ||= "px-4 py-3 text-base w-full"
  placeholder ||= ""
  label ||= nil
  input_data ||= {}

  # NOVO: Precisamos mesclar qualquer data-attribute que o dev passe
  # com o target obrigatório do nosso Stimulus controller.
  merged_input_data = input_data.merge({ password_visibility_target: "input" })

  # ==========================================
  # 2. DICIONÁRIO DE VARIANTES (OS PRÉ-ESTILOS)
  # ==========================================
  # Note a presença obrigatória do 'pr-12' na base para proteger o ícone
  base_classes = "glass-input transition-all duration-200 outline-none focus:outline-none rounded-xl pr-12"

  variant_classes = case variant
  when "default"
    "bg-black/20 border border-white/10 focus:ring-violet-500/50 focus:border-violet-500/60 text-white placeholder-white/30"
  when "danger"
    "bg-rose-500/10 border border-rose-500/50 focus:ring-rose-500/70 focus:border-rose-500 text-rose-100 placeholder-rose-200/50"
  when "outline"
    "bg-transparent border border-white/30 focus:border-violet-500 text-white placeholder-white/50"
  else
    ""
  end

  # ==========================================
  # 3. MERGE DAS CLASSES
  # ==========================================
  final_classes = "#{base_classes} #{variant_classes} #{custom_class}".strip
%>

<div class="space-y-1 w-full" data-controller="password-visibility">
  <% if label.present? %>
    <%= form.label field, label, class: "glass-label" %>
  <% end %>

  <div class="relative">
    <%= form.password_field field, class: final_classes, placeholder: placeholder, data: merged_input_data %>
    
    <!-- Botão de Visibilidade (Ícone) -->
    <!-- Adicionamos tabindex="-1" para que o usuário navegando pelo teclado (Tab) não pare no ícone acidentalmente -->
    <button type="button" 
            data-action="click->password-visibility#toggle" 
            tabindex="-1"
            class="absolute inset-y-0 right-0 flex items-center pr-4 text-white/40 hover:text-white transition-colors cursor-pointer">
      <span data-password-visibility-target="iconClosed"><%= icon "eye-slash", class: "w-5 h-5" %></span>
      <span data-password-visibility-target="iconOpen" class="hidden"><%= icon "eye", class: "w-5 h-5" %></span>
    </button>
  </div>
</div>