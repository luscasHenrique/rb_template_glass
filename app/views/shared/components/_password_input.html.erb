<%
  # ==========================================
  # 📚 COMO USAR ESTE COMPONENTE (Documentação p/ Equipe):
  # ==========================================
  # Componente de senha com alternância de visibilidade (Mostrar/Ocultar).
  # Reduz atrito de UX e previne erros de digitação (typos) em cadastros.
  #
  # <%= render "shared/components/password_input", 
  #            form: form, 
  #            field: :password, 
  #            label: "Nova Senha",
  #            placeholder: "Mínimo de 8 caracteres...",
  #            variant: @user.errors[:password].any? ? "danger" : "default",
  #            custom_class: "px-4 py-3 text-base w-full",
  #            input_data: { action: "keyup->password-strength#check" }
  # % >

  # ==========================================
  # 1. CONTRATO DE API DO COMPONENTE
  # ==========================================
  # Obrigatórios (Garante o Fail-Fast em telas críticas de Autenticação)
  cmp_form  = local_assigns.fetch(:form)
  cmp_field = local_assigns.fetch(:field)

  # Opcionais com Defaults Seguros
  cmp_variant      = local_assigns.fetch(:variant, "default")
  cmp_custom_class = local_assigns.fetch(:custom_class, "px-4 py-3 text-base w-full")
  cmp_placeholder  = local_assigns.fetch(:placeholder, "")
  cmp_label        = local_assigns.fetch(:label, nil)
  cmp_input_data   = local_assigns.fetch(:input_data, {})

  # ARQUITETURA SEGURA: Mesclamos o target do Stimulus de forma inteligente,
  # sem apagar outros 'targets' que o desenvolvedor possa ter enviado no input_data.
  existing_targets = cmp_input_data[:password_visibility_target].to_s
  merged_input_data = cmp_input_data.merge({ 
    password_visibility_target: "#{existing_targets} input".squish 
  })

  # ==========================================
  # 2. DICIONÁRIO DE VARIANTES (OS PRÉ-ESTILOS)
  # ==========================================
  # 'pr-12' é obrigatório na base para o texto não passar por baixo do ícone do olho
  base_classes = "glass-input transition-all duration-200 outline-none focus:outline-none rounded-xl pr-12"

  variant_classes = case cmp_variant
  when "danger"
    "bg-rose-500/10 border border-rose-500/50 focus:ring-rose-500/70 focus:border-rose-500 text-rose-100 placeholder-rose-200/50"
  when "outline"
    "bg-transparent border border-white/30 focus:border-violet-500 text-white placeholder-white/50"
  else
    "bg-black/20 border border-white/10 focus:ring-violet-500/50 focus:border-violet-500/60 text-white placeholder-white/30"
  end

  final_classes = "#{base_classes} #{variant_classes} #{cmp_custom_class}".strip

  # Feedback visual em caso de erro
  label_color = cmp_variant == "danger" ? "text-rose-400" : "glass-label"
  icon_color  = cmp_variant == "danger" ? "text-rose-400 hover:text-rose-300" : "text-white/40 hover:text-white"
%>

<div class="space-y-1 w-full" data-controller="password-visibility">
  <% if cmp_label.present? %>
    <%= cmp_form.label cmp_field, cmp_label, class: label_color %>
  <% end %>

  <div class="relative">
    <%= cmp_form.password_field cmp_field, class: final_classes, placeholder: cmp_placeholder, data: merged_input_data %>
    
    <!-- Botão de Visibilidade (Ícone) -->
    <!-- tabindex="-1" garante que a navegação por teclado (Acessibilidade) não foque no ícone, focando apenas no input -->
    <button type="button" 
            data-action="click->password-visibility#toggle" 
            tabindex="-1"
            class="absolute inset-y-0 right-0 flex items-center pr-4 transition-colors cursor-pointer <%= icon_color %>">
      <span data-password-visibility-target="iconClosed"><%= icon "eye-slash", class: "w-5 h-5" %></span>
      <span data-password-visibility-target="iconOpen" class="hidden"><%= icon "eye", class: "w-5 h-5" %></span>
    </button>
  </div>
</div>