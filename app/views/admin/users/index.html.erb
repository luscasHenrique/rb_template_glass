<% content_for :title, "Gestão de Usuários" %>

<div class="glass-card">
  
  <div class="flex flex-col sm:flex-row justify-between items-start sm:items-center gap-4 mb-8">
    <div>
      <h2 class="text-3xl font-bold text-white tracking-tight">Usuários do Sistema</h2>
      <p class="text-white/60 text-sm mt-1">Gerencie os acessos, permissões e status das contas cadastradas nesta plataforma.</p>
    </div>
  </div>

  <div class="overflow-hidden">
    <div class="overflow-x-auto">
      <table class="w-full text-left border-collapse">
        <thead>
          <tr class="border-b border-white/10 bg-black/20">
            <th class="p-4 text-sm font-semibold text-white/80">Usuário</th>
            <th class="p-4 text-sm font-semibold text-white/80">E-mail</th>
            <th class="p-4 text-sm font-semibold text-white/80">Nível de Acesso</th>
            <th class="p-4 text-sm font-semibold text-white/80">Status</th>
            <th class="p-4 text-sm font-semibold text-white/80 text-right">Ações</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-white/5">
          <% @users.each do |user| %>
            <tr class="hover:bg-white/5 transition-colors">
              
              <!-- Nome do Perfil -->
              <td class="p-4 text-sm font-medium text-white">
                <%= user.profile&.first_name.present? ? "#{user.profile.first_name} #{user.profile.last_name}" : "Perfil Pendente" %>
              </td>
              
              <!-- E-mail -->
              <td class="p-4 text-sm text-white/60">
                <%= user.email %>
              </td>
              
              <!-- Role (Nível de Acesso) -->
              <td class="p-4">
                <span class="glass-btn glass-btn-xsm glass-btn-outline-grey">
                  <%= user.role.capitalize %>
                </span>
              </td>
              
              <!-- Status (Ativo/Inativo) -->
              <td class="p-4">
                <% if user.active != false %>
                  <span class="glass-btn glass-btn-xsm glass-btn-outline-success">
                    Ativo
                  </span>
                <% else %>
                  <span class="glass-btn glass-btn-xsm glass-btn-outline-danger">
                    Inativo
                  </span>
                <% end %>
              </td>
              
              <!-- Ações -->
              <td class="p-4 text-right space-x-2 whitespace-nowrap">
                
                <!-- Botão Editar -->
                <%= link_to edit_admin_user_path(user), 
                            title: "Editar Permissões e Perfil", 
                            class: "glass-btn glass-btn-outline-warning w-8 h-8" do %>
                  <%= icon "pencil-square", class: "w-4 h-4" %>
                <% end %>

                <!-- Botão Histórico (Auditoria) -->
                <%= link_to audit_logs_admin_user_path(user), 
                            title: "Ver Histórico de Ações (Auditoria)", 
                            class: "glass-btn  glass-btn-outline-blue w-8 h-8" do %>
                  <%= icon "clock", class: "w-4 h-4" %>
                <% end %>

              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  </div>
</div>