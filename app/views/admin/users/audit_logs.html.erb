<% content_for :title, "Auditoria: #{@user.email}" %>

<div class="glass-card">
  
  <!-- Cabeçalho -->
  <div class="flex flex-col sm:flex-row justify-between items-start sm:items-center gap-4 mb-8">
    <div>
      <h2 class="text-3xl font-bold text-white tracking-tight">Histórico de Auditoria</h2>
      <p class="text-white/60 text-sm mt-1">Rastreabilidade completa de ações na conta de <strong class="text-white"><%= @user.email %></strong></p>
    </div>
    <%= link_to admin_users_path, class: "glass-btn glass-btn-md glass-btn-secondary" do %>
      <%= icon "arrow-left", class: "w-5 h-5 mr-1" %> Voltar
    <% end %>
  </div>

  <!-- Tabela de Logs -->
  <div class="overflow-hidden">
    <div class="overflow-x-auto">
      <table class="w-full text-left border-collapse">
        <thead>
          <tr class="border-b border-white/10 bg-black/20">
            <th class="p-4 text-sm font-semibold text-white/80">Data e Hora</th>
            <th class="p-4 text-sm font-semibold text-white/80">Ação</th>
            <th class="p-4 text-sm font-semibold text-white/80">Operador (ID)</th>
            <th class="p-4 text-sm font-semibold text-white/80 w-1/2">Detalhes da Alteração</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-white/5">
          <% @versions.each do |version| %>
            <tr class="hover:bg-white/5 transition-colors">
              
              <!-- Data/Hora da Alteração -->
              <td class="p-4 text-sm text-white/80 whitespace-nowrap">
                <%= version.created_at.strftime("%d/%m/%Y às %H:%M:%S") %>
              </td>
              
              <!-- Tipo de Evento (Criou, Atualizou, Deletou) -->
              <td class="p-4">
                <% if version.event == "create" %>
                  <span class="glass-btn glass-btn-xsm glass-btn-outline-success">Criação</span>
                <% elsif version.event == "update" %>
                  <span class="glass-btn glass-btn-xsm glass-btn-outline-blue">Atualização</span>
                <% else %>
                  <span class="glass-btn glass-btn-xsm glass-btn-outline-danger">Exclusão</span>
                <% end %>
              </td>

              <!-- Quem fez a alteração (Whodunnit) -->
              <td >
                <% if version.whodunnit.present? %>
                <span class="glass-btn glass-btn-xsm glass-btn-outline-warning">Admin ID: <%= version.whodunnit %></span>
                <% else %>
                  <span class="glass-btn glass-btn-xsm glass-btn-outline-grey">Sistema / Auto-cadastro</span>
                <% end %>
              </td>

              <!-- JSON do "Antes e Depois" -->
              <td class="p-4 text-sm">
                <% if version.changeset.present? %>
                  <ul class="space-y-2">
                    <% version.changeset.each do |attribute, values| %>
                      <%# Ignoramos dados irrelevantes para auditoria, como tokens de reset e contadores internos %>
                      <% next if %w[updated_at encrypted_password remember_created_at sign_in_count current_sign_in_at last_sign_in_at current_sign_in_ip last_sign_in_ip].include?(attribute) %>
                      
                      <li class="flex items-center gap-2 flex-wrap">
                        <strong class="text-white/80 capitalize min-w-[80px]"><%= attribute %>:</strong>
                        
                        <!-- Valor Anterior -->
                        <span class="px-2 py-1 bg-rose-500/10 text-rose-300 rounded text-xs line-through">
                          <%= values[0].nil? || values[0] == "" ? "vazio" : values[0] %>
                        </span>
                        
                        <span class="text-white/40">➜</span>
                        
                        <!-- Novo Valor -->
                        <span class="px-2 py-1 bg-emerald-500/10 text-emerald-300 rounded text-xs font-medium">
                          <%= values[1].nil? || values[1] == "" ? "vazio" : values[1] %>
                        </span>
                      </li>
                    <% end %>
                  </ul>
                <% else %>
                  <span class="text-white/30 italic">Sem detalhes granulares.</span>
                <% end %>
              </td>
            </tr>
          <% end %>

          <% if @versions.empty? %>
            <tr>
              <td colspan="4" class="p-8 text-center text-white/50 text-sm">
                Nenhuma alteração registrada na "Caixa Preta" para este usuário até o momento.
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  </div>
</div>