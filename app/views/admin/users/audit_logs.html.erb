<% content_for :title, "Auditoria: #{@user.email}" %>

<div class="glass-card">
  
  <!-- Cabeçalho -->
  <div class="flex flex-col sm:flex-row justify-between items-start sm:items-center gap-4 mb-8">
    <div>
      <h2 class="text-3xl font-bold text-white tracking-tight">Histórico de Auditoria</h2>
      <p class="text-white/60 text-sm mt-1">Rastreabilidade completa de ações na conta de <strong class="text-white"><%= @user.email %></strong></p>
    </div>
    
    <!-- Componente Padronizado -->
    <%= render "shared/components/button", 
               text: "Voltar", 
               type: "link", 
               path: admin_users_path, 
               variant: "secondary" %>
  </div>

  <!-- Tabela de Logs -->
  <div class="overflow-hidden">
    <div class="overflow-x-auto">
      <table class="w-full text-left border-collapse">
        <thead>
          <tr class="border-b border-white/10 bg-black/20">
            <th class="p-4 text-sm font-semibold text-white/80">Data e Hora</th>
            <th class="p-4 text-sm font-semibold text-white/80">Ação</th>
            <th class="p-4 text-sm font-semibold text-white/80">Operador</th>
            <th class="p-4 text-sm font-semibold text-white/80 text-center">Detalhes</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-white/5">
          <% @versions.each do |version| %>
            <tr class="hover:bg-white/5 transition-colors">
              
              <!-- Data/Hora -->
              <td class="p-4 text-sm text-white/80 whitespace-nowrap">
                <%= version.created_at.strftime("%d/%m/%Y às %H:%M:%S") %>
              </td>
              
              <!-- Tipo de Evento -->
              <td class="p-4">
                <% if version.event == "create" %>
                  <span class="glass-btn glass-btn-xsm glass-btn-outline-success">Criação</span>
                <% elsif version.event == "update" %>
                  <span class="glass-btn glass-btn-xsm glass-btn-outline-blue">Atualização</span>
                <% else %>
                  <span class="glass-btn glass-btn-xsm glass-btn-outline-danger">Exclusão</span>
                <% end %>
              </td>

              <!-- Quem fez a alteração (Com busca otimizada na memória) -->
              <td class="p-4 text-sm text-white/80">
                <% if version.whodunnit.present? %>
                  <% operator = @operators[version.whodunnit] %>
                  <% if operator %>
                    <span class="glass-btn glass-btn-xsm glass-btn-outline-grey"><%= operator.email %></span>
                  <% else %>
                    <span class="glass-btn glass-btn-xsm glass-btn-outline-warning">ID: <%= version.whodunnit %></span>
                  <% end %>
                <% else %>
                  <span class="glass-btn glass-btn-xsm glass-btn-outline-success">Sistema / API</span>
                <% end %>
              </td>

              <!-- AÇÃO: MODAL DE DETALHES -->
              <td class="p-4 text-center">
                <%= render "shared/components/button", 
                    text: "Ver Dados", 
                    type: "button", 
                    variant: "blue",
                    icon: "shield-check",
                    icon_position: "left",
                    disable_loading: true,
                    input_data: { action: "click->document.getElementById('modal_user_#{version.id}').showModal()" },
                    onclick: "document.getElementById('modal_user_#{version.id}').showModal()" %>
                
                <!-- USO DO COMPONENTE REUTILIZÁVEL -->
                <%= render layout: "shared/components/modal", locals: { id: "modal_user_#{version.id}", title: "Análise de Auditoria", icon: "shield-check" } do %>
                  
                  <!-- 1. PAINEL DE CONTEXTO -->
                  <% affected_user = audit_owner_for(version) %>
                  
                  <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 gap-4">
                    <div class="glass-card-sm">
                      <span class="glass-label-sm uppercase">Data da Ocorrência</span>
                      <span class="glass-label"><%= version.created_at.strftime("%d/%m/%Y - %H:%M") %></span>
                    </div>
                    <div class="glass-card-sm">
                      <span class="glass-label-sm uppercase">Registro Afetado</span>
                      <span class="glass-label text-violet-300"><%= version.item_type %> #<%= version.item_id %></span>
                    </div>
                    <div class="glass-card-sm">
                      <span class="glass-label-sm uppercase">Tipo de Ação</span>
                      <span class="glass-label"><%= version.event.capitalize %></span>
                    </div>
                    
                    <div class="glass-card-sm">
                      <span class="glass-label-sm uppercase">Dono do Registro</span>
                      <% if affected_user %>
                        <span class="glass-label font-medium text-emerald-300 block truncate" title="<%= affected_user.email %>">
                          <%= affected_user.email %>
                        </span>
                        <span class="glass-label block truncate">
                          <%= affected_user.profile&.first_name %> <%= affected_user.profile&.last_name %>
                        </span>
                      <% else %>
                        <span class="glass-label">Não rastreável</span>
                      <% end %>
                    </div>
                    
                    <div class="glass-card-sm md:col-span-2">
                      <span class="glass-label-sm uppercase">Operador Responsável</span>
                      <span class="glass-label text-blue-300"><%= @operators[version.whodunnit]&.email || "Sistema" %></span>
                    </div>
                  </div>

                  <!-- 2. SNAPSHOT DO REGISTRO -->
                  <h4 class="glass-section-title border-b border-white/10 pb-2 mt-8 mb-4">Snapshot do Registro (Contexto Completo)</h4>
                  
                  <% affected_record = version.item || version.reify %>

                  <% if affected_record %>
                    <div class="mb-8 max-h-60 overflow-y-auto pr-2">
                      <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 gap-4">
                        <% affected_record.attributes.except("encrypted_password", "reset_password_token", "remember_created_at").each do |key, value| %>
                          <div class="glass-card-sm !p-3">
                            <span class="glass-label-sm uppercase"><%= affected_record.class.human_attribute_name(key) rescue key %></span>
                            <span class="glass-label"><%= value.presence || "—" %></span>
                          </div>
                        <% end %>
                      </div>
                    </div>
                  <% else %>
                    <div class="glass-section-title border-b border-white/10 pb-2 mb-8">
                      <p class="text-white/50 text-sm font-normal">O snapshot completo não pôde ser recuperado (registro legado).</p>
                    </div>
                  <% end %>

                  <!-- 3. DETALHAMENTO DO CHANGESET -->
                  <h4 class="glass-section-title border-b border-white/10 pb-2 mb-4">Detalhamento das Modificações</h4>
                  
                  <% if version.changeset.present? %>
                    <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                      <% version.changeset.each do |campo, valores| %>
                        <% next if %w[updated_at encrypted_password remember_created_at sign_in_count current_sign_in_at last_sign_in_at current_sign_in_ip last_sign_in_ip].include?(campo) %>
                        
                        <div class="glass-card-sm flex flex-col justify-between">
                          <!-- TRADUÇÃO DINÂMICA SEGURA -->
                          <span class="glass-label uppercase"><%= affected_record ? affected_record.class.human_attribute_name(campo) : campo %></span>
                          
                          <div class="space-y-3 mt-3">
                            <div class="glass-btn glass-btn-md glass-btn-outline-danger flex flex-col !items-start !w-full">
                              <span class="glass-text-sm text-rose-400 uppercase text-[10px] tracking-wider mb-1">Valor Anterior</span>
                              <span class="glass-text-sm text-rose-100 break-all text-left"><%= valores[0].presence || "— (Vazio)" %></span>
                            </div>
                            <div class="glass-btn glass-btn-md glass-btn-outline-success flex flex-col !items-start !w-full">
                              <span class="glass-text-sm text-emerald-400 uppercase text-[10px] tracking-wider mb-1">Novo Valor</span>
                              <span class="glass-text-sm text-emerald-100 break-all text-left"><%= valores[1].presence || "— (Vazio)" %></span>
                            </div>
                          </div>
                        </div>
                      <% end %>
                    </div>
                  <% else %>
                    <div class="glass-card-sm flex flex-col items-center justify-center py-10 border-dashed">
                      <%= icon "information-circle", class: "glass-icon-default" %>
                      <p class="text-white/60 text-sm mt-2">Nenhum detalhamento aprofundado foi gravado nesta transação.</p>
                    </div>
                  <% end %>

                  <!-- 4. RODAPÉ DO MODAL -->
                  <div class="mt-8 flex justify-end">
                    
                    <%= render "shared/components/button", 
                    text: "Fechar Análise", 
                    type: "button",
                    variant: "secondary", 
                    onclick: "document.getElementById('modal_user_#{version.id}').close()" %>
                  </div>

                <% end %>
              </td>
            </tr>
          <% end %>

          <% if @versions.empty? %>
            <tr>
              <td colspan="4" class="p-8 text-center text-white/50 text-sm">
                Nenhuma alteração registrada na "Caixa Preta" para este usuário até o momento.
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  </div>
</div>