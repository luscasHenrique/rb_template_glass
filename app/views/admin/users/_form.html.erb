<%= form_with(model: [:admin, @user], class: "space-y-6") do |form| %>
  
  <!-- ==========================================
       TOAST DE ERROS GLOBAIS
       ========================================== -->
  <% if @user.errors.any? %>
    <div class="glass-toast-danger mb-6">
      <%= icon "x-circle", class: "w-6 h-6 shrink-0" %>
      <div>
        <h3 class="font-bold text-sm"><%= pluralize(@user.errors.count, "erro") %> impediram de salvar:</h3>
        <ul class="list-disc ml-5 text-xs mt-1">
          <% @user.errors.full_messages.each do |message| %>
            <li><%= message %></li>
          <% end %>
        </ul>
      </div>
    </div>
  <% end %>

  <!-- ==========================================
       BLOCO 1: DADOS PESSOAIS
       ========================================== -->
  <%= form.fields_for :profile, (@user.profile || @user.build_profile) do |pf| %>
    
    <div class="glass-card mb-6">
      <h3 class="glass-section-title mb-6"><%= icon "user", class: "glass-icon-primary mr-2" %> Dados Pessoais</h3>
      
      <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
        <%= render "shared/components/input", form: pf, field: :first_name, label: "Nome", 
                   variant: pf.object.errors[:first_name].any? ? "danger" : "default" %>

        <%= render "shared/components/input", form: pf, field: :last_name, label: "Sobrenome",
                   variant: pf.object.errors[:last_name].any? ? "danger" : "default" %>

        <%= render "shared/components/input", form: pf, type: "telephone", field: :phone, label: "Telefone", placeholder: "(00) 00000-0000",
                   variant: pf.object.errors[:phone].any? ? "danger" : "default",
                   input_data: { controller: "mask", mask_pattern_value: "(00) 00000-0000" } %>

        <div class="md:col-span-2">
          <%= render "shared/components/textarea", form: pf, field: :bio, label: "Biografia / Resumo", rows: 2,
                     variant: pf.object.errors[:bio].any? ? "danger" : "default" %>
        </div>
      </div>
    </div>

    <!-- ==========================================
         ENDEREÇO ANINHADO (Com Busca de CEP)
         ========================================== -->
    <div class="glass-card mb-6" data-controller="cep">
      <h3 class="glass-section-title mb-6"><%= icon "map-pin", class: "glass-icon-success mr-2" %> Endereço</h3>

      <%= pf.fields_for :address, (pf.object.address || pf.object.build_address) do |af| %>
        <div class="grid grid-cols-1 md:grid-cols-4 gap-6">
          
          <div class="md:col-span-1">
            <%= render "shared/components/input", form: af, field: :zip_code, label: "CEP", placeholder: "00000-000",
                       variant: af.object.errors[:zip_code].any? ? "danger" : "default",
                       input_data: { controller: "mask", mask_pattern_value: "00000-000", cep_target: "zipcode", action: "blur->cep#search" } %>
          </div>

          <div class="md:col-span-2">
            <%= render "shared/components/input", form: af, field: :street, label: "Rua", 
                       variant: af.object.errors[:street].any? ? "danger" : "default",
                       input_data: { cep_target: "street" } %>
          </div>

          <div class="md:col-span-1">
            <%= render "shared/components/input", form: af, field: :number, label: "Número",
                       variant: af.object.errors[:number].any? ? "danger" : "default" %>
          </div>

          <div class="md:col-span-2">
            <%= render "shared/components/input", form: af, field: :city, label: "Cidade", 
                       variant: af.object.errors[:city].any? ? "danger" : "default",
                       input_data: { cep_target: "city" } %>
          </div>

          <div class="md:col-span-2">
            <%= render "shared/components/input", form: af, field: :state, label: "Estado", 
                       variant: af.object.errors[:state].any? ? "danger" : "default",
                       input_data: { cep_target: "state" } %>
          </div>

        </div>
      <% end %>
    </div>
  <% end %>

  <!-- ==========================================
       BLOCO 2: SEGURANÇA E GOVERNANÇA (ADMIN)
       ========================================== -->
  <div class="glass-card mb-6">
    <h3 class="glass-section-title mb-6"><%= icon "shield-exclamation", class: "glass-icon-danger mr-2" %> Controle de Acesso</h3>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
      <div class="space-y-4">
        <%= render "shared/components/input", form: form, field: :email, type: "email", label: "E-mail de Acesso",
                   variant: @user.errors[:email].any? ? "danger" : "default" %>

        <%= render "shared/components/password_input", form: form, field: :password, label: "Nova Senha (deixe em branco para manter)",
                   variant: @user.errors[:password].any? ? "danger" : "default" %>
      </div>

      <div class="space-y-4">
        <%= render "shared/components/custom_select", form: form, field: :role, label: "Nível de Acesso (Role)", 
                   options: User.roles.keys.map { |r| [r.capitalize, r] }, selected: @user.role, placeholder: "Selecione um nível...",
                   variant: @user.errors[:role].any? ? "danger" : "default" %>

        <div class="mt-6">
          <%= render "shared/components/checkbox", form: form, field: :active, label: "Conta Ativa no Sistema", 
                     description: "Desmarque para bloquear o login (Soft Delete).",
                     variant: @user.errors[:active].any? ? "danger" : "default" %>
        </div>
      </div>
    </div>
  </div>

  <!-- AÇÕES DE SALVAMENTO -->
  <div class="flex items-center justify-end gap-4 pt-4 border-t border-white/10">
    <%= link_to "Cancelar", admin_users_path, class: "glass-btn glass-btn-md glass-btn-secondary" %>
    <%= form.submit "Salvar Alterações", class: "glass-btn glass-btn-md glass-btn-primary" %>
  </div>
<% end %>