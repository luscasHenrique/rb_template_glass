<% content_for :title, "Editar Usuário: #{@user.email}" %>

<div class="w-full max-w-4xl mx-auto space-y-6">
  <div class="mb-8">
    <h2 class="text-3xl font-bold text-white tracking-tight">Editar Permissões</h2>
    <p class="text-white/60 text-sm mt-1">Altere o nível de acesso, credenciais ou desative a conta de <%= @user.email %>.</p>
  </div>

  <div class="glass-card">
    <h3 class="glass-section-title mb-6">
      <%= icon "shield-exclamation", class: "glass-icon-primary mr-2" %>
      Controle de Acesso
    </h3>
    
    <%= render "form", user: @user %>
  </div>
</div>