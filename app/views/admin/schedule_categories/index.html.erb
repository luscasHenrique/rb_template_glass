<div class="flex flex-col gap-8">
  <div class="flex flex-col sm:flex-row justify-between items-start sm:items-center gap-4">
    <div>
      <h1 class="text-3xl font-bold text-white">Categorias de Agendamento</h1>
      <p class="text-white/80 mt-2">Gerencie os tipos de eventos permitidos no calendário corporativo.</p>
    </div>
    <div>
      <%= render "shared/components/button", text: "Nova Categoria", type: "link", path: new_admin_schedule_category_path, variant: "primary", icon: "plus", data: { turbo_frame: "modal_container" } %>
    </div>
  </div>

  <div class="glass-card !p-0 overflow-hidden">
    <div class="overflow-x-auto">
      <table class="w-full text-left border-collapse">
        <thead class="bg-black/20 border-b border-white/10">
          <tr>
            <th class="p-4 text-xs font-semibold text-white/50 uppercase tracking-wider">Categoria</th>
            <th class="p-4 text-xs font-semibold text-white/50 uppercase tracking-wider">Cor / Ícone</th>
            <th class="p-4 text-xs font-semibold text-white/50 uppercase tracking-wider text-center">Status</th>
            <th class="p-4 text-xs font-semibold text-white/50 uppercase tracking-wider text-right">Ações</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-white/10">
          <% @schedule_categories.each do |category| %>
            <tr class="hover:bg-white/5 transition-colors">
              <td class="p-4 text-white font-medium"><%= category.name %></td>
              <td class="p-4">
                <!-- Usando a nossa Fonte Única de Verdade (Helper) -->
                <span class="inline-flex items-center gap-2 px-2 py-1 rounded border <%= glass_theme_classes(category.color, :badge) %> text-sm">
                  <%= icon(category.icon.presence || "calendar", class: "w-4 h-4 shrink-0") %>
                  <%= category.color.capitalize %>
                </span>
              </td>
              <td class="p-4 text-center">
                <% if category.active? %>
                  <span class="px-2 py-1 bg-emerald-500/20 text-emerald-300 border border-emerald-500/30 rounded text-xs font-bold uppercase">Ativo</span>
                <% else %>
                  <span class="px-2 py-1 bg-white/10 text-white/50 border border-white/20 rounded text-xs font-bold uppercase">Inativo</span>
                <% end %>
              </td>
              <td class="p-4 text-right">
                <div class="flex items-center justify-end gap-2">
                  <%= render "shared/components/icon_button", type: "link", path: edit_admin_schedule_category_path(category), icon: "pencil", variant: "secondary", data: { turbo_frame: "modal_container" }, title: "Editar" %>
                  <%= render "shared/components/icon_button", type: "button_to", method: :delete, path: admin_schedule_category_path(category), icon: "trash", variant: "danger", data: { turbo_confirm: "Tem certeza que deseja apagar esta categoria? Os agendamentos ligados a ela perderão o vínculo." }, title: "Apagar" %>
                </div>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  </div>
</div>
<%= turbo_frame_tag "modal_container" %>