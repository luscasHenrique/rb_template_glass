<% content_for :title, "Recuperação de Senha" %>

<!-- Centraliza o card na tela (ideal para páginas de autenticação isoladas) -->
<div class="flex items-center justify-center min-h-[80vh]">
  <div class="glass-card w-full max-w-md">
    
    <div class="text-center mb-6">
      <%= icon "key", class: "w-12 h-12 text-violet-400 mx-auto mb-4" %>
      <h2 class="text-2xl font-bold text-white tracking-tight">Esqueceu sua senha?</h2>
      <p class="text-white/60 text-sm mt-2">Informe seu e-mail cadastrado para receber as instruções de recuperação.</p>
    </div>

    <%= form_for(resource, as: resource_name, url: password_path(resource_name), html: { method: :post, class: "space-y-6" }) do |f| %>
      <%= render "devise/shared/error_messages", resource: resource %>

      <div class="space-y-1">
        <%= f.label :email, "E-mail de Acesso", class: "glass-label" %>
        <%= f.email_field :email, autofocus: true, autocomplete: "email", class: "glass-input glass-input-md glass-input-default", placeholder: "seu@email.com.br" %>
      </div>

      <div>
        <%= f.submit "Enviar instruções de recuperação", class: "glass-btn glass-btn-md glass-btn-primary w-full" %>
      </div>
    <% end %>

    <hr class="border-white/10 my-6">

    <!-- Container flexível para alinhar os links compartilhados -->
    <div class="text-center flex flex-col gap-4">
      <%= render "devise/shared/links" %>
    </div>

  </div>
</div>