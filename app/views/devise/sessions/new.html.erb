<div class="w-full">
  <div class="text-center mb-8">
    <h2 class="text-3xl font-bold text-white mb-2">Bem-vindo de volta</h2>
    <p class="text-white/70 text-sm">Acesse sua conta para continuar</p>
  </div>

  <%= form_for(resource, as: resource_name, url: session_path(resource_name), html: { class: "space-y-6" }) do |f| %>
    
    <!-- Campo de E-mail (Componentizado) -->
    <%= render "shared/components/input", 
               form: f, 
               field: :email, 
               type: "email", 
               label: "E-mail", 
               placeholder: "seu@email.com" %>

    <!-- Campo de Senha (Componentizado) -->
    <%= render "shared/components/password_input", 
               form: f, 
               field: :password, 
               label: "Senha",
               placeholder: "••••••••",
               input_data: { autocomplete: "current-password" } %>

    <!-- Lembrar-me e Esqueci a Senha -->
    <div class="flex items-center justify-between text-sm">
      <% if devise_mapping.rememberable? %>
        <!-- Componente de Checkbox sem o padding padrão para alinhar com o link -->
        <%= render "shared/components/checkbox", 
                   form: f, 
                   field: :remember_me, 
                   label: "Lembrar-me",
                   variant: "minimal" %>
      <% end %>

      <%- if devise_mapping.recoverable? && controller_name != 'passwords' && controller_name != 'registrations' %>
        <%= link_to "Esqueceu a senha?", new_password_path(resource_name), class: "text-white font-semibold hover:underline" %>
      <% end %>
    </div>

    <!-- Botão de Login (Componentizado) -->
    <div class="pt-2">
      <%= render "shared/components/button", 
                 text: "Entrar", 
                 type: "submit", 
                 variant: "primary", 
                 custom_class: "w-full",
                 loading_text: "Autenticando..." %>
    </div>
  <% end %>

  <!-- Link para Cadastro -->
  <%- if devise_mapping.registerable? && controller_name != 'registrations' %>
    <div class="mt-6 text-center text-sm text-white/70">
      Não tem uma conta? 
      <%= link_to "Cadastre-se", new_registration_path(resource_name), class: "text-white font-semibold hover:underline" %>
    </div>
  <% end %>
</div>