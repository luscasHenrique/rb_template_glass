<div class="w-full">
  <div class="text-center mb-8">
    <h2 class="text-3xl font-bold text-white mb-2">Bem-vindo de volta</h2>
    <p class="text-white/70 text-sm">Acesse sua conta para continuar</p>
  </div>

  <%= form_for(resource, as: resource_name, url: session_path(resource_name), html: { class: "space-y-6" }) do |f| %>
    
    <!-- Campo de E-mail -->
    <div class="space-y-1">
      <%= f.label :email, class: "glass-label" %>
      <%= f.email_field :email, autofocus: true, autocomplete: "email", 
          class: "glass-input glass-input-md glass-input-default",
          placeholder: "seu@email.com" %>
    </div>

    <!-- Campo de Senha com Toggle via Stimulus -->
    <div class="space-y-1" data-controller="password-visibility">
      <%= f.label :password, "Senha", class: "glass-label" %>
      
      <div class="relative">
        <%= f.password_field :password, autocomplete: "current-password", 
            data: { password_visibility_target: "input" },
            class: "glass-input glass-input-md glass-input-default",
            placeholder: "••••••••" %>
        
        <!-- Botão com os ícones SVG -->
        <button type="button" data-action="click->password-visibility#toggle" class="absolute inset-y-0 right-0 flex items-center pr-4 cursor-pointer text-white/50 hover:text-white transition-colors">
          <svg data-password-visibility-target="iconClosed" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-5 h-5">
            <path stroke-linecap="round" stroke-linejoin="round" d="M3.98 8.223A10.477 10.477 0 001.934 12C3.226 16.338 7.244 19.5 12 19.5c.993 0 1.953-.138 2.863-.395M6.228 6.228A10.45 10.45 0 0112 4.5c4.756 0 8.773 3.162 10.065 7.498a10.523 10.523 0 01-4.293 5.774M6.228 6.228L3 3m3.228 3.228l3.65 3.65m7.894 7.894L21 21m-3.228-3.228l-3.65-3.65m0 0a3 3 0 10-4.243-4.243m4.242 4.242L9.88 9.88" />
          </svg>
          <svg data-password-visibility-target="iconOpen" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-5 h-5 hidden">
            <path stroke-linecap="round" stroke-linejoin="round" d="M2.036 12.322a1.012 1.012 0 010-.639C3.423 7.51 7.36 4.5 12 4.5c4.638 0 8.573 3.007 9.963 7.178.07.207.07.431 0 .639C20.577 16.49 16.64 19.5 12 19.5c-4.638 0-8.573-3.007-9.963-7.178z" />
            <path stroke-linecap="round" stroke-linejoin="round" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" />
          </svg>
        </button>
      </div>
    </div>

    <!-- Lembrar-me e Esqueci a Senha -->
    <div class="flex items-center justify-between text-sm">
      <% if devise_mapping.rememberable? %>
        <div class="flex items-center gap-2">
          <%= f.check_box :remember_me, class: "glass-checkbox" %>
          <%= f.label :remember_me, "Lembrar-me", class: "text-white/80 select-none cursor-pointer" %>
        </div>
      <% end %>

      <%- if devise_mapping.recoverable? && controller_name != 'passwords' && controller_name != 'registrations' %>
        <%= link_to "Esqueceu a senha?", new_password_path(resource_name), class: "text-white font-semibold hover:underline" %>
      <% end %>
    </div>

    <!-- Botão de Login (Adicionado w-full para preencher o bloco) -->
    <div class="pt-2">
      <%= f.submit "Entrar", class: "glass-btn glass-btn-md glass-btn-primary w-full" %>
    </div>
  <% end %>

  <!-- Link para Cadastro -->
  <%- if devise_mapping.registerable? && controller_name != 'registrations' %>
    <div class="mt-6 text-center text-sm text-white/70">
      Não tem uma conta? 
      <%= link_to "Cadastre-se", new_registration_path(resource_name), class: "text-white font-semibold hover:underline" %>
    </div>
  <% end %>
</div>