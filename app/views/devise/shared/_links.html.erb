<%- if controller_name != 'sessions' %>
  <%= link_to "Já possui uma conta? Entrar", new_session_path(resource_name), class: "text-sm font-medium text-violet-300 hover:text-violet-200 transition-colors" %>
<% end %>

<%- if devise_mapping.registerable? && controller_name != 'registrations' %>
  <%= link_to "Não tem uma conta? Cadastre-se", new_registration_path(resource_name), class: "text-sm font-medium text-violet-300 hover:text-violet-200 transition-colors" %>
<% end %>

<%- if devise_mapping.recoverable? && controller_name != 'passwords' && controller_name != 'registrations' %>
  <%= link_to "Esqueceu sua senha?", new_password_path(resource_name), class: "text-sm text-white/60 hover:text-white transition-colors" %>
<% end %>

<%- if devise_mapping.confirmable? && controller_name != 'confirmations' %>
  <%= link_to "Não recebeu as instruções de confirmação?", new_confirmation_path(resource_name), class: "text-sm text-white/60 hover:text-white transition-colors" %>
<% end %>

<%- if devise_mapping.lockable? && resource_class.unlock_strategy_enabled?(:email) && controller_name != 'unlocks' %>
  <%= link_to "Não recebeu as instruções de desbloqueio?", new_unlock_path(resource_name), class: "text-sm text-white/60 hover:text-white transition-colors" %>
<% end %>

<!-- Tratamento visual para Login Social (Google, Facebook, etc) -->
<%- if devise_mapping.omniauthable? %>
  <%- resource_class.omniauth_providers.each do |provider| %>
    <%= button_to "Entrar com #{OmniAuth::Utils.camelize(provider)}", omniauth_authorize_path(resource_name, provider), data: { turbo: false }, class: "glass-btn glass-btn-sm glass-btn-secondary w-full mt-2" %>
  <% end %>
<% end %>