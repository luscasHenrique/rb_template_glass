<div class="w-full">
  <div class="text-center mb-8">
    <h2 class="text-3xl font-bold text-white mb-2">Criar Conta</h2>
    <p class="text-white/70 text-sm">Preencha os dados abaixo para se cadastrar</p>
  </div>

  <%= form_for(resource, as: resource_name, url: registration_path(resource_name), html: { class: "space-y-6" }) do |f| %>
    
    <!-- Renderiza as mensagens de erro do Devise -->
    <%= render "devise/shared/error_messages", resource: resource %>

    <!-- ==========================================
         DADOS DO PERFIL (Nome e Sobrenome)
         ========================================== -->
    <%= f.fields_for :profile, (resource.profile || resource.build_profile) do |pf| %>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
        <%= render "shared/components/input", 
                   form: pf, 
                   field: :first_name, 
                   label: "Nome", 
                   placeholder: "Seu nome",
                   variant: pf.object.errors[:first_name].any? ? "danger" : "default" %>

        <%= render "shared/components/input", 
                   form: pf, 
                   field: :last_name, 
                   label: "Sobrenome", 
                   placeholder: "Seu sobrenome",
                   variant: pf.object.errors[:last_name].any? ? "danger" : "default" %>
      </div>
    <% end %>

    <!-- ==========================================
         CREDENCIAIS DE ACESSO (User)
         ========================================== -->
    <!-- Campo de E-mail -->
    <%= render "shared/components/input", 
               form: f, 
               field: :email, 
               type: "email", 
               label: "E-mail de Acesso", 
               placeholder: "seu@email.com",
               variant: resource.errors[:email].any? ? "danger" : "default" %>

    <!-- Campo de Senha -->
    <% password_label = @minimum_password_length ? "Senha (mínimo #{@minimum_password_length} caracteres)" : "Senha" %>
    <%= render "shared/components/password_input", 
               form: f, 
               field: :password, 
               label: password_label,
               placeholder: "••••••••",
               variant: resource.errors[:password].any? ? "danger" : "default" %>

    <!-- Campo de Confirmação de Senha -->
    <%= render "shared/components/password_input", 
               form: f, 
               field: :password_confirmation, 
               label: "Confirmar Senha",
               placeholder: "••••••••",
               variant: resource.errors[:password_confirmation].any? ? "danger" : "default" %>

    <!-- Botão de Cadastro -->
    <div class="pt-2">
      <%= render "shared/components/button", 
                 text: "Criar Conta", 
                 type: "submit", 
                 variant: "primary", 
                 custom_class: "w-full",
                 loading_text: "Criando conta..." %>
    </div>
  <% end %>

  <!-- Link de Retorno para o Login -->
  <%- if controller_name != 'sessions' %>
    <div class="mt-6 text-center text-sm text-white/70">
      Já tem uma conta? 
      <%= link_to "Entrar", new_session_path(resource_name), class: "text-white font-semibold hover:underline" %>
    </div>
  <% end %>
</div>