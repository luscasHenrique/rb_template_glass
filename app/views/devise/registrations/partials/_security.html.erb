<div class="glass-card" data-controller="password-visibility">
  <h3 class="glass-section-title">
    <svg xmlns="http://www.w3.org/2000/svg" class="glass-icon-danger" fill="none" viewBox="0 0 24 24" stroke="currentColor">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z" />
    </svg>
    Segurança e Acesso
  </h3>
  
  <div class="grid grid-cols-1 md:grid-cols-2 gap-6 mb-6">
    <div class="space-y-1 md:col-span-2">
      <%= f.label :email, "E-mail de Acesso", class: "block text-sm font-medium text-white/80" %>
      <%= f.email_field :email, autocomplete: "email", class: "glass-input" %>
    </div>

    <!-- Nova Senha com Visibilidade Corrigida -->
    <div class="space-y-1" data-controller="password-visibility">
      <%= f.label :password, "Nova Senha (deixe em branco se não quiser mudar)", class: "block text-sm font-medium text-white/80" %>
      <div class="relative">
        <%= f.password_field :password, autocomplete: "new-password", data: { password_visibility_target: "input" }, class: "glass-input pr-12" %>
        <button type="button" data-action="click->password-visibility#toggle" class="absolute inset-y-0 right-0 flex items-center pr-4 text-white/40 hover:text-white transition-colors cursor-pointer">
          <svg data-password-visibility-target="iconClosed" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-5 h-5"><path stroke-linecap="round" stroke-linejoin="round" d="M3.98 8.223A10.477 10.477 0 001.934 12C3.226 16.338 7.244 19.5 12 19.5c.993 0 1.953-.138 2.863-.395M6.228 6.228A10.45 10.45 0 0112 4.5c4.756 0 8.773 3.162 10.065 7.498a10.523 10.523 0 01-4.293 5.774M6.228 6.228L3 3m3.228 3.228l3.65 3.65m7.894 7.894L21 21m-3.228-3.228l-3.65-3.65m0 0a3 3 0 10-4.243-4.243m4.242 4.242L9.88 9.88" /></svg>
          <svg data-password-visibility-target="iconOpen" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-5 h-5 hidden"><path stroke-linecap="round" stroke-linejoin="round" d="M2.036 12.322a1.012 1.012 0 010-.639C3.423 7.51 7.36 4.5 12 4.5c4.638 0 8.573 3.007 9.963 7.178.07.207.07.431 0 .639C20.577 16.49 16.64 19.5 12 19.5c-4.638 0-8.573-3.007-9.963-7.178z" /><path stroke-linecap="round" stroke-linejoin="round" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" /></svg>
        </button>
      </div>
    </div>

    <!-- Confirmar Senha com Visibilidade Corrigida -->
    <div class="space-y-1" data-controller="password-visibility">
      <%= f.label :password_confirmation, "Confirmar Nova Senha", class: "block text-sm font-medium text-white/80" %>
      <div class="relative">
        <%= f.password_field :password_confirmation, autocomplete: "new-password", data: { password_visibility_target: "input" }, class: "glass-input pr-12" %>
        <button type="button" data-action="click->password-visibility#toggle" class="absolute inset-y-0 right-0 flex items-center pr-4 text-white/40 hover:text-white transition-colors cursor-pointer">
          <svg data-password-visibility-target="iconClosed" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-5 h-5"><path stroke-linecap="round" stroke-linejoin="round" d="M3.98 8.223A10.477 10.477 0 001.934 12C3.226 16.338 7.244 19.5 12 19.5c.993 0 1.953-.138 2.863-.395M6.228 6.228A10.45 10.45 0 0112 4.5c4.756 0 8.773 3.162 10.065 7.498a10.523 10.523 0 01-4.293 5.774M6.228 6.228L3 3m3.228 3.228l3.65 3.65m7.894 7.894L21 21m-3.228-3.228l-3.65-3.65m0 0a3 3 0 10-4.243-4.243m4.242 4.242L9.88 9.88" /></svg>
          <svg data-password-visibility-target="iconOpen" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-5 h-5 hidden"><path stroke-linecap="round" stroke-linejoin="round" d="M2.036 12.322a1.012 1.012 0 010-.639C3.423 7.51 7.36 4.5 12 4.5c4.638 0 8.573 3.007 9.963 7.178.07.207.07.431 0 .639C20.577 16.49 16.64 19.5 12 19.5c-4.638 0-8.573-3.007-9.963-7.178z" /><path stroke-linecap="round" stroke-linejoin="round" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" /></svg>
        </button>
      </div>
    </div>
  </div>
</div>