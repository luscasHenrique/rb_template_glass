<div class="glass-card">
  <h3 class="glass-section-title">
    <svg xmlns="http://www.w3.org/2000/svg" class="glass-icon-primary" fill="none" viewBox="0 0 24 24" stroke="currentColor">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z" />
    </svg>
    Dados Pessoais
  </h3>
  
  <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
    <div class="space-y-1">
      <%= pf.label :first_name, "Nome", class: "block text-sm font-medium text-white/80" %>
      <%= pf.text_field :first_name, autofocus: true, data: { controller: "capitalize", action: "input->capitalize#format" }, class: "glass-input", placeholder: "João" %>
    </div>

    <div class="space-y-1">
      <%= pf.label :last_name, "Sobrenome", class: "block text-sm font-medium text-white/80" %>
      <%= pf.text_field :last_name, data: { controller: "capitalize", action: "input->capitalize#format" }, class: "glass-input", placeholder: "Silva" %>
    </div>

    <div class="space-y-1">
      <%= pf.label :phone, "Telefone", class: "block text-sm font-medium text-white/80" %>
      <%= pf.text_field :phone, class: "glass-input", placeholder: "(11) 99999-9999" %>
    </div>

    <div class="space-y-1 md:col-span-2">
      <%= pf.label :bio, "Biografia / Resumo", class: "block text-sm font-medium text-white/80" %>
      <%= pf.text_area :bio, rows: 3, class: "glass-input resize-none", placeholder: "Fale um pouco sobre você..." %>
    </div>
  </div>
</div>