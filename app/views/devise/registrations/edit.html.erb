<% content_for :title, "Meu Perfil" %>

<div class="w-full space-y-6">

  <%= form_for(resource, as: resource_name, url: registration_path(resource_name), html: { method: :put, class: "space-y-6" }) do |f| %>
    <%= render "devise/shared/error_messages", resource: resource %>

    <!-- ==========================================
         BLOCO 1 E 2: DADOS PESSOAIS E ENDEREÇO (PROFILE)
         ========================================== -->
    <%= f.fields_for :profile, (resource.profile || resource.build_profile) do |pf| %>
      
      <!-- 1. DADOS PESSOAIS -->
      <div class="glass-card">
        <h2 class="text-3xl font-bold text-white tracking-tight">Configurações de Perfil</h2>
        <p class="text-white/60 text-sm mt-1">Gerencie suas informações pessoais, localização e credenciais de acesso.</p>
        
        <h3 class="glass-section-title mt-6">
          <%= icon "user", class: "glass-icon-primary mr-2" %>
          Dados Pessoais
        </h3>
        
        <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
          <%= render "shared/components/input", 
                     form: pf, field: :first_name, label: "Nome", placeholder: "João",
                     input_data: { controller: "capitalize", action: "input->capitalize#format" },
                     variant: pf.object.errors[:first_name].any? ? "danger" : "default" %>

          <%= render "shared/components/input", 
                     form: pf, field: :last_name, label: "Sobrenome", placeholder: "Silva",
                     input_data: { controller: "capitalize", action: "input->capitalize#format" },
                     variant: pf.object.errors[:last_name].any? ? "danger" : "default" %>

          <%= render "shared/components/input", 
                     form: pf, field: :phone, label: "Telefone", placeholder: "(11) 99999-9999",
                     variant: pf.object.errors[:phone].any? ? "danger" : "default" %>

          <div class="md:col-span-2">
            <%= render "shared/components/textarea", 
                       form: pf, field: :bio, label: "Biografia / Resumo", rows: 3, placeholder: "Fale um pouco sobre você...",
                       variant: pf.object.errors[:bio].any? ? "danger" : "default" %>
          </div>
        </div>
      </div>

      <!-- 2. ENDEREÇO -->
      <div class="glass-card mt-6" data-controller="cep">
        <h3 class="glass-section-title">
          <%= icon "map-pin", class: "glass-icon-success mr-2" %>
          Endereço
        </h3>

        <%= pf.fields_for :address, (pf.object.address || pf.object.build_address) do |af| %>
          <div class="grid grid-cols-1 md:grid-cols-4 gap-6">
            <div class="md:col-span-1">
              <%= render "shared/components/input", 
                         form: af, field: :zip_code, label: "CEP", placeholder: "00000-000",
                         input_data: { cep_target: "zipcode", action: "blur->cep#search" },
                         variant: af.object.errors[:zip_code].any? ? "danger" : "default" %>
            </div>

            <div class="md:col-span-2">
              <%= render "shared/components/input", 
                         form: af, field: :street, label: "Rua",
                         input_data: { cep_target: "street" },
                         variant: af.object.errors[:street].any? ? "danger" : "default" %>
            </div>

            <div class="md:col-span-1">
              <%= render "shared/components/input", 
                         form: af, field: :number, label: "Número",
                         variant: af.object.errors[:number].any? ? "danger" : "default" %>
            </div>

            <div class="md:col-span-1">
              <%= render "shared/components/input", 
                         form: af, field: :complement, label: "Complemento", placeholder: "Apto 12, Bloco C",
                         variant: af.object.errors[:complement].any? ? "danger" : "default" %>
            </div>

            <div class="md:col-span-2">
              <%= render "shared/components/input", 
                         form: af, field: :city, label: "Cidade",
                         input_data: { cep_target: "city" },
                         variant: af.object.errors[:city].any? ? "danger" : "default" %>
            </div>

            <div class="md:col-span-1">
              <%= render "shared/components/input", 
                         form: af, field: :state, label: "Estado", placeholder: "SP",
                         input_data: { cep_target: "state" },
                         variant: af.object.errors[:state].any? ? "danger" : "default" %>
            </div>
          </div>
        <% end %>
      </div>
    <% end %>

    <!-- ==========================================
         BLOCO 3 E 4: SEGURANÇA E AÇÕES (USER)
         ========================================== -->
    
    <!-- 3. SEGURANÇA -->
    <div class="glass-card mt-6">
      <h3 class="glass-section-title">
        <%= icon "shield-exclamation", class: "glass-icon-danger mr-2" %>
        Segurança e Acesso
      </h3>
      
      <div class="grid grid-cols-1 md:grid-cols-2 gap-6 mb-6">
        <div class="md:col-span-2">
          <%= render "shared/components/input", 
                     form: f, field: :email, type: "email", label: "E-mail de Acesso",
                     input_data: { autocomplete: "email" },
                     variant: resource.errors[:email].any? ? "danger" : "default" %>
        </div>

        <%= render "shared/components/password_input", 
                   form: f, field: :password, label: "Nova Senha (deixe em branco se não quiser mudar)",
                   input_data: { autocomplete: "new-password" },
                   variant: resource.errors[:password].any? ? "danger" : "default" %>

        <%= render "shared/components/password_input", 
                   form: f, field: :password_confirmation, label: "Confirmar Nova Senha",
                   input_data: { autocomplete: "new-password" },
                   variant: resource.errors[:password_confirmation].any? ? "danger" : "default" %>
      </div>
    </div>

    <!-- 4. AÇÕES (CONFIRMAÇÃO COM SENHA ATUAL) -->
    <div class="glass-card mt-6 flex flex-col md:flex-row items-center justify-between gap-6">
      <div class="w-full md:w-1/2">
        <div class="mb-2">
          <span class="block text-sm font-bold text-violet-300">Senha Atual</span>
          <p class="text-xs text-white/50">Para salvar qualquer alteração acima, digite sua senha atual.</p>
        </div>
        <%= render "shared/components/password_input", 
                   form: f, field: :current_password,
                   input_data: { autocomplete: "current-password", required: true },
                   variant: resource.errors[:current_password].any? ? "danger" : "default" %>
      </div>

      <div class="w-full md:w-auto mt-4 md:mt-0 flex flex-col sm:flex-row justify-end gap-4">
        <%= render "shared/components/button", 
                   text: "Voltar", type: "link", path: :back, variant: "secondary",
                   custom_class: "w-full sm:w-auto" %>
                   
        <%= render "shared/components/button", 
                   text: "Salvar Alterações", type: "submit", variant: "success",
                   custom_class: "w-full sm:w-auto", loading_text: "Salvando..." %>
      </div>
    </div>

  <% end %>
</div>