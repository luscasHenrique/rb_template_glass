
<% content_for :title, "Gerenciar Acesso à Agenda" %>

<div class="flex flex-col gap-8">
  
  <!-- ==========================================
       BLOCO 1: CONCEDER ACESSO
       ========================================== -->
  <div class="glass-card relative z-20">
    <h2 class="glass-section-title mb-4"><%= icon "user-plus", class: "glass-icon-primary mr-2" %> Adicionar Assistente</h2>
    
    <%= form_with(model: ScheduleDelegation.new, url: schedule_delegations_path, class: "flex flex-col md:flex-row gap-4 items-end") do |form| %>
      <div class="flex-grow w-full md:w-2/3">
        <%= render "shared/components/multi_select", 
                   form: form, 
                   field: :delegate_id, 
                   label: "Selecione o Usuário", 
                   options: @available_users, 
                   placeholder: "Buscar colaborador ativo no sistema..." %>
      </div>
      
      <div class="w-full md:w-auto">
        <%= render "shared/components/button", 
                   text: "Conceder Acesso", 
                   type: "submit", 
                   variant: "primary", 
                   icon: "check" %>
      </div>
    <% end %>
  </div>

  <!-- ==========================================
       BLOCO 2: AUDITORIA E REVOGAÇÃO (PADRÃO DESIGN SYSTEM)
       ========================================== -->
  <div class="glass-card">
    
    <div class="flex flex-col sm:flex-row justify-between items-start sm:items-center gap-4 mb-8">
      <div>
        <h2 class="text-3xl font-bold text-white tracking-tight">Acessos Ativos</h2>
        <p class="text-white/60 text-sm mt-1">Colaboradores com permissão para gerenciar sua agenda.</p>
      </div>
    </div>

    <div class="overflow-hidden">
      <div class="overflow-x-auto">
        <table class="w-full text-left border-collapse">
          <thead>
            <tr class="border-b border-white/10 bg-black/20">
              <th class="p-4 text-sm font-semibold text-white/80">Usuário Delegado</th>
              <th class="p-4 text-sm font-semibold text-white/80">E-mail</th>
              <th class="p-4 text-sm font-semibold text-white/80 text-right">Ações</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-white/5">
            
            <% if @delegations.any? %>
              <% @delegations.each do |delegation| %>
                <tr class="hover:bg-white/5 transition-colors">
                  
                  <!-- Nome do Perfil -->
                  <td class="p-4 text-sm font-medium text-white">
                    <%= delegation.delegate.profile&.first_name.present? ? "#{delegation.delegate.profile.first_name} #{delegation.delegate.profile.last_name}" : "Perfil Pendente" %>
                  </td>
                  
                  <!-- E-mail -->
                  <td class="p-4 text-sm text-white/60">
                    <%= delegation.delegate.email %>
                  </td>
                  
                  <!-- Ações -->
                  <td class="p-4 text-right whitespace-nowrap">
                    <div class="flex items-center justify-end gap-3">
                      <%= render "shared/components/icon_button", 
                                 type: "button_to", 
                                 method: :delete, 
                                 path: schedule_delegation_path(delegation), 
                                 icon: "trash", 
                                 variant: "danger", 
                                 data: { turbo_confirm: "Revogar o acesso deste usuário à sua agenda? Ele não poderá mais criar ou editar seus eventos." }, 
                                 title: "Revogar Acesso" %>
                    </div>
                  </td>
                  
                </tr>
              <% end %>
            <% else %>
              
              <!-- Empty State -->
              <tr>
                <td colspan="3" class="p-8 text-center text-sm text-white/50">
                  <%= icon "lock-closed", class: "w-8 h-8 mx-auto mb-2 opacity-50" %>
                  Ninguém tem acesso para gerenciar sua agenda no momento.
                </td>
              </tr>
              
            <% end %>
          </tbody>
        </table>
      </div>
    </div>
  </div>

  <!-- ==========================================
       BLOCO 3: AGENDAS SOB MINHA GESTÃO
       ========================================== -->
  <div class="glass-card">
    <div class="flex flex-col sm:flex-row justify-between items-start sm:items-center gap-4 mb-8">
      <div>
        <h2 class="text-3xl font-bold text-white tracking-tight">Agendas sob Minha Gestão</h2>
        <p class="text-white/60 text-sm mt-1">Diretores ou colegas que autorizaram você a organizar seus compromissos.</p>
      </div>
    </div>

    <div class="overflow-hidden">
      <div class="overflow-x-auto">
        <table class="w-full text-left border-collapse">
          <thead>
            <tr class="border-b border-white/10 bg-black/20">
              <th class="p-4 text-sm font-semibold text-white/80">Nome do Gestor</th>
              <th class="p-4 text-sm font-semibold text-white/80">E-mail</th>
              <th class="p-4 text-sm font-semibold text-white/80 text-right">Ação</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-white/5">
            <% gestores = current_user.delegators.includes(:profile) %>
            
            <% if gestores.any? %>
              <% gestores.each do |gestor| %>
                <tr class="hover:bg-white/5 transition-colors">
                  <td class="p-4 text-sm font-medium text-white">
                    <%= gestor.profile&.first_name.present? ? "#{gestor.profile.first_name} #{gestor.profile.last_name}" : "Perfil Pendente" %>
                  </td>
                  <td class="p-4 text-sm text-white/60">
                    <%= gestor.email %>
                  </td>
                  <td class="p-4 text-right whitespace-nowrap">
                    <%= render "shared/components/button", 
                               text: "Acessar Agenda", 
                               type: "link", 
                               path: schedule_items_path(manager_id: gestor.id), 
                               variant: "outline-blue", 
                               icon: "calendar-days" %>
                  </td>
                </tr>
              <% end %>
            <% else %>
              <!-- Empty State -->
              <tr>
                <td colspan="3" class="p-8 text-center text-sm text-white/50">
                  <%= icon "inbox", class: "w-8 h-8 mx-auto mb-2 opacity-50" %>
                  Você não gerencia a agenda de nenhum usuário no momento.
                </td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    </div>
  </div>

</div>