<% content_for :title, "Auditoria - v#{@policy_term.version}" %>

<div class="overflow-x-auto glass-card mt-8">
  <div class="flex flex-col sm:flex-row justify-between items-start sm:items-center mb-6 gap-4">
    <h3 class="glass-section-title mb-0">
      <%= icon "shield-check", class: "glass-icon-info mr-2" %>
      Relatório de Aceites
      
      <span class="ml-2 pl-2 border-l border-white/20 text-white/60 font-medium text-lg">
        Versão <%= @policy_term.version %>
      </span>
    </h3>
    
    <%= link_to "Voltar", policy_terms_path, class: "glass-btn glass-btn-secondary glass-btn-sm" %>
  </div>
  
  <hr class="border-white/10 my-0">

<table class="min-w-full divide-y divide-white/10 text-left mt-2">
    <thead>
      <tr>
        <th scope="col" class="py-4 pl-4 pr-3 text-xs uppercase tracking-wider font-semibold text-white/50">Usuário Signatário</th>
        <th scope="col" class="px-3 py-4 text-xs uppercase tracking-wider font-semibold text-white/50">Recibo (Hash)</th>
        <!-- Separamos os cabeçalhos -->
        <th scope="col" class="px-3 py-4 text-xs uppercase tracking-wider font-semibold text-white/50">Data</th>
        <th scope="col" class="px-3 py-4 text-xs uppercase tracking-wider font-semibold text-white/50">Hora</th>
        <th scope="col" class="px-3 py-4 text-xs uppercase tracking-wider font-semibold text-white/50">IP Registrado</th>
        <th scope="col" class="px-3 py-4 text-xs uppercase tracking-wider font-semibold text-white/50 text-center">Validade Legal</th>
      </tr>
    </thead>
    <tbody class="divide-y divide-white/5">
      <% @policy_term.user_agreements.includes(:user).each do |agreement| %>
        <tr class="hover:bg-white/5 transition-colors duration-200">
          
          <td class="whitespace-nowrap py-4 pl-4 pr-3 text-sm font-medium text-white flex items-center gap-3">
            <div class="w-8 h-8 rounded-full bg-white/5 flex items-center justify-center border border-white/10 shrink-0">
              <%= icon "user", class: "w-4 h-4 text-white/50" %>
            </div>
            <%= agreement.user.email %>
          </td>
          
          <td class="whitespace-nowrap px-3 py-4 text-sm text-cyan-400/80 font-mono">
            #<%= agreement.id.to_s(16).rjust(8, '0').upcase %>
          </td>

          <!-- NOVA COLUNA: Apenas a Data com ícone de calendário -->
          <td class="whitespace-nowrap px-3 py-4 text-sm text-white/80">
            <%= icon "calendar", class: "w-4 h-4 inline mr-1 text-white/30 -mt-0.5" %>
            <%= agreement.accepted_at.strftime("%d/%m/%Y") %>
          </td>

          <!-- NOVA COLUNA: Apenas a Hora com fonte monoespaçada e ícone de relógio -->
          <td class="whitespace-nowrap px-3 py-4 text-sm text-white/60 font-mono">
            <%= icon "clock", class: "w-4 h-4 inline mr-1 text-white/30 -mt-0.5" %>
            <%= agreement.accepted_at.strftime("%H:%M:%S") %>
          </td>

          <td class="whitespace-nowrap px-3 py-4 text-sm text-white/60 font-mono">
            <%= agreement.ip_address == "::1" ? "127.0.0.1 (Local)" : agreement.ip_address %>
          </td>

          <td class="whitespace-nowrap px-3 py-4 text-sm text-center">
            <span class="inline-flex items-center px-3 py-1 rounded-full text-xs font-bold border-2 border-emerald-500 bg-emerald-500/10 text-emerald-100 shadow-[0_0_10px_rgba(16,185,129,0.3)] cursor-default">
              <%= icon "check", class: "w-3 h-3 mr-1" %>
              ACEITO
            </span>
          </td>

        </tr>
      <% end %>
    </tbody>
  </table>

  <% if @policy_term.user_agreements.empty? %>
    <div class="mt-8 mb-4 p-8 text-center text-sm text-white/50 bg-black/20 rounded-xl border border-white/5">
      <%= icon "document-magnifying-glass", class: "w-10 h-10 mx-auto mb-3 text-white/20" %>
      Nenhum usuário assinou esta versão do documento ainda.
    </div>
  <% end %>
</div>