<% content_for :title, "Novo Termo de Política" %>

<div class="glass-card">
  
  <!-- CABEÇALHO DA TELA DE CRIAÇÃO -->
  <div class="flex flex-col sm:flex-row justify-between items-start sm:items-center gap-4 mb-8 border-b border-white/10 pb-6">
    <div>
      <h1 class="text-3xl font-bold text-white tracking-tight flex items-center gap-3">
        <%= icon "plus-circle", class: "text-emerald-400 w-8 h-8" %>
        Novo Termo de Uso
      </h1>
      <p class="text-white/60 text-sm mt-1">Crie uma nova versão das políticas de privacidade ou termos da plataforma.</p>
    </div>
  </div>

  <!-- RENDERIZAÇÃO DO FORMULÁRIO -->
  <%= render "form", policy_term: @policy_term %>
  
</div>