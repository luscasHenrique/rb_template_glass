

<%= form_with(model: policy_term, class: "glass-card space-y-6") do |form| %>
  <h2 class="glass-section-title mb-6">
  <%= icon "document-text", class: "glass-icon-primary" %>
  Formulário de Termo de Uso
</h2>
  <!-- Tratamento de Erros -->
  <% if policy_term.errors.any? %>
    <div id="error_explanation" class="bg-rose-500/10 border border-rose-500/50 text-rose-200 px-4 py-3 rounded-xl mb-6 shadow-[0_0_15px_rgba(225,29,72,0.2)]">
      <h2 class="font-bold mb-2 text-rose-400 text-sm uppercase tracking-wider">
        <%= pluralize(policy_term.errors.count, "erro impediu", "erros impediram") %> este termo de ser salvo:
      </h2>
      <ul class="list-disc ml-6 text-sm">
        <% policy_term.errors.each do |error| %>
          <li><%= error.full_message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <!-- CAMPO: VERSÃO (Usando o Componente de Input) -->
  <%= render "shared/components/input", 
             form: form, 
             field: :document_version, 
             label: "Versão do Documento",
             placeholder: "Ex: v1.0, v2026.1",
             variant: policy_term.errors[:document_version].any? ? "danger" : "default" %>

  <!-- CAMPO: CONTEÚDO JURÍDICO (Usando o Componente de Textarea) -->
  <%= render "shared/components/textarea", 
             form: form, 
             field: :content, 
             label: "Conteúdo Jurídico (Termo)",
             rows: 8,
             placeholder: "Cole o texto completo do contrato aqui..." %>

  <!-- CAMPO: STATUS ATIVO (Usando o Componente de Checkbox encapsulado num card menor) -->
  <div class="p-4 bg-black/20 border border-white/10 rounded-xl hover:bg-black/30 transition-colors duration-200">
    <%= render "shared/components/checkbox", 
               form: form, 
               field: :active, 
               variant: "minimal",
               label: "Publicar como Termo Ativo e Exigir Aceite" %>
               
  </div>

  <!-- BOTÕES DE AÇÃO -->
  <div class="pt-6 mt-6 border-t border-white/10 flex items-center justify-between">
    <!-- Botão Secundário (Voltar) -->
    <%= render "shared/components/button", 
               text: "Cancelar", 
               type: "link", 
               path: policy_terms_path, 
               variant: "secondary" %>

    <!-- Botão Primário (Salvar) -->
    <%= render "shared/components/button", 
               text: "Salvar Termo", 
               type: "submit", 
               variant: "success",
               icon: "check" %>
  </div>
<% end %>