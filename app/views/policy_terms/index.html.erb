<% content_for :title, "Gestão de Termos de Uso" %>

<div class="glass-card">
  <!-- Cabeçalho da Seção -->
  <div class="flex flex-col sm:flex-row justify-between items-center mb-8 gap-4">
    <h2 class="glass-section-title mb-0">
      <%= icon "document-text", class: "glass-icon-primary" %>
      Gestão de Termos e (LGPD)
    </h2>
    
    <!-- Botão Modular (Primary) -->
    <%= link_to "Novo Termo", new_policy_term_path, class: "glass-btn glass-btn-md glass-btn-primary" %>
  </div>

  <!-- Tabela de Dados (Substituindo a lista vertical do Scaffold) -->
  <div class="overflow-x-auto">
    <table class="min-w-full divide-y divide-white/10 text-left">
      <thead>
        <tr>
          <th scope="col" class="py-3 px-4 text-sm font-semibold text-white/90">Versão</th>
          <th scope="col" class="py-3 px-4 text-sm font-semibold text-white/90">Resumo do Conteúdo</th>
          <th scope="col" class="py-3 px-4 text-sm font-semibold text-white/90 text-center">Status</th>
          <th scope="col" class="py-3 px-4 text-sm font-semibold text-white/90 text-right">Ações</th>
        </tr>
      </thead>
      
      <tbody class="divide-y divide-white/10">
        <% if @policy_terms.any? %>
          <% @policy_terms.each do |policy_term| %>
            <tr class="hover:bg-white/5 transition-colors duration-200">
              
              <!-- Coluna: Versão -->
              <td class="whitespace-nowrap py-4 px-4 text-sm font-medium text-white">
                v<%= policy_term.version %>
              </td>
              
              <!-- Coluna: Conteúdo (Truncado para não quebrar o layout) -->
              <td class="py-4 px-4 text-sm text-white/70 max-w-xs truncate">
                <%= policy_term.content %>
              </td>
              
              <!-- Coluna: Status (Badges visuais) -->
              <td class="whitespace-nowrap py-4 px-4 text-sm text-center">
                <% if policy_term.active? %>
                  <span class="glass-btn glass-btn-xsm glass-btn-outline-success">
                    Ativo
                  </span>
                <% else %>
                  <span class="glass-btn glass-btn-xsm glass-btn-outline-danger">
                    Inativo
                  </span>
                <% end %>
              </td>
              
              <!-- Coluna: Ações -->
              <td class="whitespace-nowrap py-4 px-4 text-right flex justify-end gap-2">
                <%= link_to "Detalhes", policy_term, class: "glass-btn glass-btn-sm glass-btn-info" %>
                
                <!-- Inteligência UI: Consulta a Regra de Negócio do Pundit -->
                <% if policy(policy_term).edit? %>
                  <%= link_to "Editar", edit_policy_term_path(policy_term), class: "glass-btn glass-btn-sm glass-btn-warning" %>
                <% else %>
                  <!-- Botão fantasma/desabilitado mostrando que está trancado -->
                  <span title="Contrato já possui assinaturas e está imutável" class="glass-btn glass-btn-sm border border-white/10 text-white/30 cursor-not-allowed bg-black/20">
                    <%= icon "lock-closed", class: "w-4 h-4 mr-1 inline" %> Lacrado
                  </span>
                <% end %>
              </td>
              
            </tr>
          <% end %>
        <% else %>
          <tr>
            <td colspan="4" class="py-10 text-center text-sm text-white/50 bg-black/20 rounded-xl border border-white/5">
              Nenhum termo de política cadastrado ainda. Clique em "Novo Termo" para começar.
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
</div>