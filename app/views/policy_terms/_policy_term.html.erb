<div id="<%= dom_id policy_term %>" class="w-full sm:w-auto my-5 space-y-5">
  <div>
    <strong class="block font-medium mb-1">Version:</strong>
    <%= policy_term.version %>
  </div>
  <div>
    <strong class="block font-medium mb-1">Content:</strong>
    <%= policy_term.content %>
  </div>
  <div>
    <strong class="block font-medium mb-1">Active:</strong>
    <%= policy_term.active? ? "Yes" : "No" %>
  </div>
</div>
