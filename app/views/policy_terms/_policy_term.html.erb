<div id="<%= dom_id policy_term %>" class="glass-card mb-6">
  
  <!-- CABEÇALHO DO CARD DE DETALHES -->
  <div class="border-b border-white/10 pb-4 mb-6 flex flex-wrap gap-4 justify-between items-center">
    <h3 class="glass-section-title text-lg m-0">
      <%= icon "document-check", class: "glass-icon-primary" %>
      Detalhes do Termo de Uso
    </h3>
    
    <!-- STATUS DO TERMO (Pílula/Badge Visual) -->
    <% if policy_term.active? %>
      <span class="glass-btn glass-btn-xsm glass-btn-outline-success cursor-default">
        <%= icon "check-circle", class: "w-4 h-4 mr-1" %> Ativo (Em Vigor)
      </span>
    <% else %>
      <span class="glass-btn glass-btn-xsm glass-btn-outline-grey cursor-default">
        <%= icon "archive-box", class: "w-4 h-4 mr-1" %> Inativo / Histórico
      </span>
    <% end %>
  </div>

  <!-- CONTEÚDO (Grid Responsivo) -->
  <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
    
    <!-- VERSÃO -->
    <div class="glass-card-sm">
      <span class="glass-label-sm uppercase"><%= PolicyTerm.human_attribute_name(:document_version) %></span>
      <span class="text-white font-semibold text-lg block mt-1"><%= policy_term.document_version %></span>
    </div>

    <!-- DATA DE CRIAÇÃO (Sempre útil em documentos legais) -->
    <div class="glass-card-sm">
      <span class="glass-label-sm uppercase"><%= PolicyTerm.human_attribute_name(:created_at) %></span>
      <span class="glass-label block mt-1"><%= policy_term.created_at.strftime("%d/%m/%Y às %H:%M") %></span>
    </div>

    <!-- TEXTO JURÍDICO (Ocupa a largura total e possui Scroll) -->
    <div class="glass-card-sm md:col-span-2 flex flex-col h-full">
      <span class="glass-label-sm uppercase mb-3"><%= PolicyTerm.human_attribute_name(:content) %></span>
      
      <!-- Caixa de texto simulando um documento formal com limite de altura -->
      <div class="bg-black/40 border border-white/5 rounded-lg p-5 flex-1 max-h-96 overflow-y-auto custom-scrollbar">
        <p class="text-white/80 text-sm leading-relaxed whitespace-pre-wrap"><%= policy_term.content %></p>
      </div>
    </div>
    
  </div>
</div>