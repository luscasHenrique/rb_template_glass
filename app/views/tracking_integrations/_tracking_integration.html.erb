<div id="<%= dom_id tracking_integration %>" class="w-full sm:w-auto my-5 space-y-5">
  <div>
    <strong class="block font-medium mb-1">Provider name:</strong>
    <%= tracking_integration.provider_name %>
  </div>
  <div>
    <strong class="block font-medium mb-1">Account:</strong>
    <%= tracking_integration.account_id %>
  </div>
  <div>
    <strong class="block font-medium mb-1">Is active:</strong>
    <%= tracking_integration.is_active? ? "Yes" : "No" %>
  </div>
</div>
