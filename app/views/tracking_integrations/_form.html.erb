<%= form_with(model: tracking_integration, class: "space-y-6") do |form| %>
  
  <!-- Tratamento de Erros Padronizado -->
  <% if tracking_integration.errors.any? %>
    <div id="error_explanation" class="bg-rose-500/10 border border-rose-500/50 text-rose-200 px-4 py-3 rounded-xl mb-6 shadow-[0_0_15px_rgba(225,29,72,0.2)]">
      <h2 class="font-bold mb-2 text-rose-400 text-sm uppercase tracking-wider">
        <%= pluralize(tracking_integration.errors.count, "erro impediu", "erros impediram") %> de salvar:
      </h2>
      <ul class="list-disc ml-6 text-sm">
        <% tracking_integration.errors.each do |error| %>
          <li><%= error.full_message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
    <!-- Componente de Input: Provider -->
    <%= render "shared/components/input", 
               form: form, 
               field: :provider_name, 
               label: "Provedor (ex: GTM, Meta)",
               placeholder: "Ex: Google Tag Manager",
               variant: tracking_integration.errors[:provider_name].any? ? "danger" : "default" %>

    <!-- Componente de Input: Account ID -->
    <%= render "shared/components/input", 
               form: form, 
               field: :account_id, 
               label: "ID da Conta (Tracking ID)",
               placeholder: "Ex: GTM-XXXXXXX",
               variant: tracking_integration.errors[:account_id].any? ? "danger" : "default" %>
  </div>

  <!-- Componente de Checkbox -->
  <div class="p-4 bg-black/20 border border-white/10 rounded-xl hover:bg-black/30 transition-colors duration-200">
    <%= render "shared/components/checkbox", 
               form: form, 
               field: :is_active, 
               variant: "minimal",
               label: "Integração Ativa (Inserir script no sistema)" %>
  </div>

  <!-- Botões de Ação no Rodapé -->
  <div class="pt-6 mt-6 border-t border-white/10 flex items-center justify-between">
    <%= render "shared/components/button", 
               text: "Cancelar", 
               type: "link", 
               path: tracking_integrations_path, 
               variant: "secondary" %>

    <%= render "shared/components/button", 
               text: "Salvar Integração", 
               type: "submit", 
               variant: "success",
               icon: "check" %>
  </div>
<% end %>