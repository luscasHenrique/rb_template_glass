<%= form_with(model: tracking_integration, class: "space-y-6") do |form| %>
  <% if tracking_integration.errors.any? %>
    <div class="glass-toast-danger mb-6">
      <%= icon "x-circle", class: "w-6 h-6 shrink-0" %>
      <div>
        <h3 class="font-bold text-sm"><%= pluralize(tracking_integration.errors.count, "erro") %> impediram de salvar:</h3>
        <ul class="list-disc ml-5 text-xs mt-1">
          <% tracking_integration.errors.each do |error| %>
            <li><%= error.full_message %></li>
          <% end %>
        </ul>
      </div>
    </div>
  <% end %>

  <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
    <div class="space-y-1">
      <%= form.label :provider_name, "Provedor (ex: GTM, Meta)", class: "glass-label" %>
      <%= form.text_field :provider_name, class: "glass-input glass-input-md glass-input-default", placeholder: "GTM" %>
    </div>

    <div class="space-y-1">
      <%= form.label :account_id, "ID da Conta (Tracking ID)", class: "glass-label" %>
      <%= form.text_field :account_id, class: "glass-input glass-input-md glass-input-default", placeholder: "GTM-XXXXXXX" %>
    </div>
  </div>

  <div class="flex items-center gap-3 mt-4 bg-white/5 p-4 rounded-xl border border-white/10">
    <%= form.check_box :is_active, class: "glass-checkbox" %>
    <%= form.label :is_active, "Integração Ativa", class: "text-sm font-medium text-white cursor-pointer select-none m-0" %>
  </div>

  <div class="flex items-center justify-end gap-4 pt-4">
    <%= link_to "Cancelar", tracking_integrations_path, class: "glass-btn glass-btn-md glass-btn-secondary" %>
    <%= form.submit "Salvar Integração", class: "glass-btn glass-btn-md glass-btn-success" %>
  </div>
<% end %>