<!-- BACKDROP: Clique fora fecha o menu no Mobile (Refatorado para animação suave) -->
<div data-sidebar-target="backdrop" 
     data-action="click->sidebar#closeMobile"
     class="fixed inset-0 bg-black/60 backdrop-blur-sm z-40 md:hidden transition-all duration-300 ease-in-out opacity-0 pointer-events-none cursor-pointer">
</div>

<!-- CORREÇÃO 1: Removido o 'md:z-auto', mantendo o z-50 absoluto para todas as telas -->
<aside data-controller="sidebar" 
       data-action="mobile-menu:toggle@window->sidebar#toggleMobile"
       data-sidebar-target="aside" 
       class="fixed md:relative top-4 left-4 md:top-0 md:left-0 z-50 h-[calc(100vh-2rem)] md:h-full w-64 bg-white/5 backdrop-blur-2xl border border-white/10 rounded-3xl flex flex-col transition-all duration-300 ease-in-out shadow-2xl flex-shrink-0 -translate-x-[120%] md:translate-x-0">
  
  <!-- Botão Flutuante Desktop -->
  <button type="button" 
          data-action="click->sidebar#toggle" 
          class="hidden md:block absolute -right-3.5 top-6 z-50 p-1.5 rounded-full bg-white/10 hover:bg-white/20 border border-white/20 text-white/80 hover:text-white backdrop-blur-md shadow-lg transition-all cursor-pointer">
    <svg data-sidebar-target="toggleIcon" xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 transition-all duration-300 ease-in-out" fill="none" viewBox="0 0 24 24" stroke="currentColor">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M15 19l-7-7 7-7" />
    </svg>
  </button>

  <!-- Topo / Logo + Botão X (Mobile) -->
  <div data-sidebar-target="centerWrapper" class="h-20 shrink-0 flex items-center justify-between px-6 border-b border-white/10 transition-all">
    <div class="flex items-center">
      <div class="w-8 h-8 rounded-xl bg-violet-600 flex items-center justify-center font-bold text-white shadow-[0_0_12px_rgba(124,58,237,0.5)] shrink-0">T</div>
      <span data-sidebar-target="text" class="text-xl font-bold text-white tracking-wide ml-3 truncate">Glass</span>
    </div>
    
    <button type="button" 
            data-action="click->sidebar#closeMobile" 
            class="md:hidden p-2 rounded-xl bg-white/5 hover:bg-white/10 border border-white/10 text-white/70 hover:text-white transition-all cursor-pointer">
      <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
      </svg>
    </button>
  </div>

  <!-- CORREÇÃO 2: Removido 'overflow-x-hidden' para não guilhotinar o tooltip -->
  <nav class="flex-1 overflow-y-auto p-3 space-y-2">
    <% @nav_items.group_by { |item| item[:section] }.each do |section, items| %>
      <% if section %>
        <div data-sidebar-target="text" class="pt-4 pb-1 px-3 text-[10px] font-bold text-white/40 uppercase tracking-widest"><%= section %></div>
      <% end %>
      
      <% items.each do |item| %>
        
        <!-- ========================================== -->
        <!-- RENDERIZAÇÃO 1: ITEM PAI COM SUBMENUS      -->
        <!-- ========================================== -->
        <% if item[:sub_items].present? %>
          <div class="group flex flex-col">
            
            <button type="button" 
                    data-action="click->sidebar#toggleSubmenu" 
                    data-sidebar-target="centerWrapper"
                    class="w-full flex items-center justify-between px-3 py-3 rounded-xl text-white/70 hover:text-white hover:bg-white/10 transition-all cursor-pointer">
              
              <div class="flex items-center gap-3">
                <%= icon item[:icon].to_s, class: "h-5 w-5 text-violet-400 shrink-0 group-hover:scale-110 transition-transform" %>
                <span data-sidebar-target="text" class="font-medium text-sm truncate"><%= item[:title] %></span>
              </div>
              
              <svg data-sidebar-target="text" xmlns="http://www.w3.org/2000/svg" class="submenu-chevron h-4 w-4 text-white/40 transition-transform duration-200 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
              </svg>
            </button>
            
            <div class="submenu-list hidden flex-col pl-11 pr-3 py-1 space-y-1">
              <% item[:sub_items].each do |sub_item| %>
                <%= link_to sub_item[:path].call, 
                    data: { action: "click->sidebar#closeMobile" }, 
                    class: "py-2 text-xs font-medium text-white/50 hover:text-white hover:text-violet-300 transition-colors block truncate" do %>
                  <%= sub_item[:title] %>
                <% end %>
              <% end %>
            </div>

            <!-- Tooltip Mapeado Corretamente -->
            <div data-sidebar-target="tooltip" class="hidden absolute left-full mt-2 ml-4 px-3 py-1.5 bg-slate-900/90 backdrop-blur-xl border border-white/20 text-white text-xs font-semibold rounded-xl whitespace-nowrap opacity-0 group-hover:opacity-100 pointer-events-none transition-all duration-200 shadow-2xl z-50">
              <%= item[:title] %>
            </div>

          </div>

        <!-- ========================================== -->
        <!-- RENDERIZAÇÃO 2: LINK SIMPLES DIRETO        -->
        <!-- ========================================== -->
        <% else %>
          <div class="group flex items-center">
            <%= link_to item[:path].call, 
                data: { 
                  sidebar_target: "centerWrapper",
                  action: "click->sidebar#closeMobile"
                },
                class: "w-full flex items-center gap-3 px-3 py-3 rounded-xl text-white/70 hover:text-white hover:bg-white/10 transition-all group" do %>
              <%= icon item[:icon].to_s, class: "h-5 w-5 text-violet-400 shrink-0 group-hover:scale-110 transition-transform" %>
              <span data-sidebar-target="text" class="font-medium text-sm truncate"><%= item[:title] %></span>
            <% end %>

            <!-- Tooltip do Item Simples -->
            <div data-sidebar-target="tooltip" class="hidden absolute left-full mt-2 ml-4 px-3 py-1.5 bg-slate-900/90 backdrop-blur-xl border border-white/20 text-white text-xs font-semibold rounded-xl whitespace-nowrap opacity-0 group-hover:opacity-100 pointer-events-none transition-all duration-200 shadow-2xl z-50">
              <%= item[:title] %>
            </div>
          </div>
        <% end %>

      <% end %>
    <% end %>
  </nav>

  <!-- Rodapé -->
  <div class="shrink-0 p-3 border-t border-white/10 bg-black/10 rounded-b-3xl space-y-3">
    <%= link_to edit_user_registration_path, 
        data: { sidebar_target: "centerWrapper", action: "click->sidebar#closeMobile" },
        class: "flex items-center gap-3 p-2 -mx-1 rounded-2xl hover:bg-white/10 transition-all group cursor-pointer" do %>
      <div class="w-9 h-9 rounded-xl bg-white/10 border border-white/20 flex items-center justify-center text-white font-bold backdrop-blur-md shrink-0 group-hover:border-violet-400/50 transition-colors">
        <%= @user.email[0].upcase %>
      </div>
      <div data-sidebar-target="footerText" class="flex-1 min-w-0">
        <p class="text-xs font-semibold text-white truncate group-hover:text-violet-200 transition-colors"><%= @user.email.split('@').first %></p>
        <p class="text-[10px] text-violet-300 font-medium capitalize"><%= @user.role %></p>
      </div>
    <% end %>

    <div data-sidebar-target="footerText" class="pt-2 border-t border-white/5 text-[10px] text-white/50 space-y-1">
      <div class="flex items-center gap-2">
        <span class="h-2 w-2 rounded-full bg-emerald-400 shadow-[0_0_6px_rgba(52,211,153,0.8)]"></span>
        <span>Sistema Operacional (v1.0)</span>
      </div>
      <p>© 2026 Template Glass. Todos os direitos reservados.</p>
    </div>

    <%= button_to destroy_user_session_path, method: :delete, 
        data: { sidebar_target: "centerWrapper" },
        class: "w-full py-2.5 px-3 bg-white/5 hover:bg-red-500/20 border border-white/10 rounded-xl text-white/70 hover:text-red-400 transition-all text-xs font-medium flex items-center gap-2 group cursor-pointer" do %>
      <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 16l4-4m0 0l-4-4m4 4H7m6 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h4a3 3 0 013 3v1" />
      </svg>
      <span data-sidebar-target="footerText">Sair</span>
    <% end %>
  </div>
</aside>